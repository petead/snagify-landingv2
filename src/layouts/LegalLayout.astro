---
const { title, description, slug, ogDescription, robots, jsonLd } = Astro.props;
const canonical = `https://snagify.net/${slug}`;
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CrispChat from '../components/CrispChat.astro';
import Clarity from '../components/Clarity.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import Fonts from '../components/Fonts.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
<GoogleAnalytics />
<MetaPixel />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription ?? description}>
<meta property="og:url" content={canonical}>
<link rel="canonical" href={canonical}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={ogDescription ?? description}>{robots ? <meta name="robots" content={robots} /> : ''}{jsonLd ? jsonLd.map((item) => (
<script type="application/ld+json" set:html={JSON.stringify(item)} />
)) : ''}

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" href="/favicon.ico">

<Fonts />

<style>
html[lang="en"], html[lang="en"] body {
  direction: ltr !important;
  text-align: left;
}

* { cursor: auto; }
a, button, [role="button"], .faq-q, .toc-list a, .btn-ink, .btn-ghost, .btn-cta, .btn-cta-outline, .btn-submit, .cc-link, .ch-cta { cursor: pointer; }
input, textarea, select { cursor: text; }
input[type="checkbox"], input[type="radio"] { cursor: pointer; }

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --cream: #F3F1EB;
  --cream-2: #EAE8E0;
  --white: #FCFCFC;
  --ink: #0E0E10;
  --ink-60: rgba(14,14,16,0.6);
  --ink-25: rgba(14,14,16,0.1);
  --purple: #9A88FD;
  --purple-bg: #EDE9FE;
  --green: #CAFE87;
  --green-bg: #EEFAD5;
  --jasmine: #FEDE80;
  --jasmine-bg: #FFF8DC;
}
html { scroll-behavior: smooth; }
body {
  font-family: 'DM Sans', sans-serif;
  background: var(--cream);
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
}
</style>
<slot name="styles" />
<CrispChat />
<Clarity />
</head>
<body>

<SiteHeader />

<slot />

<SiteFooter />

<slot name="scripts" />

</body>
</html>
