---
/**
 * Shared chrome for Resources hub + category indexes.
 */
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CrispChat from '../components/CrispChat.astro';
import Clarity from '../components/Clarity.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import ResourceBreadcrumbs from '../components/ResourceBreadcrumbs.astro';

interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  breadcrumbs: Crumb[];
}

const { title, description, canonical, breadcrumbs } = Astro.props;
const ogImage = 'https://snagify.net/og-image.jpg';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.href ? { item: c.href.startsWith('http') ? c.href : `https://snagify.net${c.href}` } : {}),
  })),
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<GoogleAnalytics />
<MetaPixel />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:site_name" content="Snagify">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" href="/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,700;0,800;1,700;1,800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet">
<style is:global>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --cream: #F3F1EB;
  --white: #FCFCFC;
  --ink: #0E0E10;
  --ink-60: rgba(14,14,16,0.6);
  --ink-25: rgba(14,14,16,0.1);
  --purple: #9A88FD;
  --lime: #CAFE87;
  --coral: #FF8F6B;
  --lime-ink: #1a2e0a;
}
body {
  font-family: 'DM Sans', sans-serif;
  background: var(--cream);
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
}
a { cursor: pointer; }

.rh-wrap {
  max-width: 1100px;
  margin: 0 auto;
  padding: 56px 24px 96px;
}
.rh-head { margin-bottom: 36px; max-width: 40rem; }
.rh-eyebrow {
  font-size: 12px; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--ink-60); margin-bottom: 12px;
}
.rh-head h1 {
  font-family: 'Poppins', sans-serif; font-weight: 800;
  font-size: clamp(32px, 5vw, 48px); letter-spacing: -1.6px;
  line-height: 1.08; margin-bottom: 14px;
}
.rh-sub { font-size: 17px; line-height: 1.65; color: var(--ink-60); }

.rh-filters {
  display: flex; flex-wrap: wrap; gap: 8px;
  margin-bottom: 40px;
}
.rh-chip {
  appearance: none; border: 1px solid var(--ink-25); background: transparent;
  font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 13px;
  padding: 8px 14px; border-radius: 999px; color: var(--ink-60);
  cursor: pointer; transition: background .2s, color .2s, border-color .2s;
}
.rh-chip:hover { border-color: var(--ink); color: var(--ink); }
.rh-chip.is-active {
  background: var(--ink); color: var(--white); border-color: var(--ink);
}

.rh-featured {
  display: block; text-decoration: none; color: inherit;
  background: var(--ink); color: var(--white);
  border-radius: 20px; padding: 32px 36px;
  margin-bottom: 56px;
  transition: transform .25s ease, box-shadow .25s ease;
}
.rh-featured:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 40px rgba(14,14,16,.22);
}
.rh-featured .rh-card-badge { background: var(--lime); color: var(--lime-ink); }
.rh-featured .rh-card-title {
  font-family: 'Poppins', sans-serif; font-weight: 800;
  font-size: clamp(22px, 3vw, 30px); letter-spacing: -0.8px;
  line-height: 1.2; margin: 14px 0 12px; color: var(--white);
}
.rh-featured .rh-card-desc { color: rgba(252,252,252,.72); max-width: 54ch; margin-bottom: 16px; }
.rh-featured .rh-card-meta { color: rgba(252,252,252,.55); font-size: 13px; display: flex; gap: 8px; }

.rh-section { margin-bottom: 56px; }
.rh-section[hidden] { display: none !important; }
.rh-section-head {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 16px; margin-bottom: 20px; flex-wrap: wrap;
}
.rh-section-title {
  font-family: 'Poppins', sans-serif; font-weight: 800;
  font-size: 22px; letter-spacing: -0.5px;
  display: flex; align-items: center; gap: 10px;
}
.rh-dot {
  width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
}
.rh-dot-guide { background: var(--lime); }
.rh-dot-blog { background: var(--purple); }
.rh-dot-tutorial { background: var(--coral); }
.rh-view-all {
  font-size: 14px; font-weight: 600; color: var(--purple);
  text-decoration: none;
}
.rh-view-all:hover { text-decoration: underline; }

.rh-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
}
.rh-card {
  display: flex; flex-direction: column; gap: 10px;
  background: var(--white);
  border: 1px solid var(--ink-25);
  border-radius: 16px;
  padding: 22px 22px 20px;
  text-decoration: none; color: inherit;
  transition: border-color .2s, transform .2s, box-shadow .2s;
  min-height: 100%;
}
.rh-card:hover {
  border-color: rgba(154,136,253,.45);
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(14,14,16,.06);
}
/* Badge styles live in CategoryBadge.astro (single source). */
.rh-card-title {
  font-family: 'Poppins', sans-serif; font-weight: 700;
  font-size: 1.05rem; letter-spacing: -0.3px; line-height: 1.3;
}
.rh-card:hover .rh-card-title { color: var(--purple); }
.rh-card-desc {
  font-size: 14.5px; line-height: 1.55; color: var(--ink-60);
  flex: 1;
}
.rh-card-meta {
  font-size: 12.5px; color: var(--ink-60);
  display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px;
}
.rh-empty { color: var(--ink-60); font-size: 15px; padding: 12px 0; }

@media (max-width: 640px) {
  .rh-wrap { padding: 40px 18px 72px; }
  .rh-featured { padding: 24px 20px; }
}
</style>
<CrispChat />
<Clarity />
</head>
<body>
<SiteHeader />
<main class="rh-wrap">
  <ResourceBreadcrumbs crumbs={breadcrumbs} />
  <slot />
</main>
<SiteFooter />
</body>
</html>
