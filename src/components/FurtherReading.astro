---
import type { FurtherReadingItem } from '../lib/further-reading';

interface Props {
  items: FurtherReadingItem[];
  heading?: string;
}

const { items, heading = 'Further reading' } = Astro.props;
---

{items.length > 0 && (
  <section class="further-reading" aria-labelledby="further-reading-heading">
    <h2 class="further-reading-heading" id="further-reading-heading">{heading}</h2>
    <ul class="further-reading-list">
      {items.map((item) => (
        <li class="further-reading-item">
          <a href={item.href} class="further-reading-link">{item.title}</a>
          <p class="further-reading-desc">{item.description}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
.further-reading {
  margin: 48px 0 24px;
  padding-top: 36px;
  border-top: 1px solid rgba(14, 14, 16, 0.1);
}
.further-reading-heading {
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  font-size: 22px;
  letter-spacing: -0.5px;
  margin: 0 0 20px;
  color: #0e0e10;
}
.further-reading-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.further-reading-item {
  margin: 0;
  padding: 0;
}
.further-reading-link {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 16px;
  letter-spacing: -0.25px;
  line-height: 1.35;
  color: #0e0e10;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color 0.2s, border-color 0.2s;
}
.further-reading-link:hover {
  color: #9a88fd;
  border-bottom-color: rgba(154, 136, 253, 0.45);
}
.further-reading-desc {
  margin: 6px 0 0;
  font-size: 14.5px;
  line-height: 1.55;
  color: rgba(14, 14, 16, 0.6);
  max-width: 62ch;
}
</style>
