---
/**
 * Soft-gate checklist lead magnet.
 * Email is requested; the PDF link is always revealed after submit.
 */
const GOOGLE_ADS_ID = (import.meta.env.PUBLIC_GOOGLE_ADS_ID as string | undefined)?.trim() || '';
const GOOGLE_ADS_LEAD_LABEL = (import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_LABEL as string | undefined)?.trim() || '';
const PDF_HREF = '/downloads/dubai-move-in-checklist.pdf';
---

<aside class="checklist-dl" data-checklist-download aria-label="Move-in checklist download">
  <div class="checklist-dl-form-wrap" data-checklist-form>
    <h2 class="checklist-dl-title">The printable move-in checklist</h2>
    <p class="checklist-dl-line">
      One A4 page, 20 checkboxes, the exact order that protects your deposit. Free, straight to your inbox and your printer.
    </p>
    <form class="checklist-dl-form" data-checklist-form-el novalidate>
      <label class="sr-only" for="checklist-email">Email</label>
      <input
        id="checklist-email"
        class="checklist-dl-input"
        type="email"
        name="email"
        autocomplete="email"
        required
        placeholder="you@example.com"
        data-checklist-email
      />
      <button type="submit" class="checklist-dl-btn" data-checklist-btn>Send me the PDF</button>
    </form>
    <p class="checklist-dl-note">No spam. One useful email, that's it.</p>
    <p class="checklist-dl-error" data-checklist-error hidden></p>
  </div>
  <div class="checklist-dl-success" data-checklist-success hidden>
    <p class="checklist-dl-success-msg" data-checklist-success-msg>Sent. And here it is right away:</p>
    <a
      class="checklist-dl-link"
      href={PDF_HREF}
      download="dubai-move-in-checklist.pdf"
      data-checklist-pdf
    >Download the PDF →</a>
  </div>
</aside>

<style is:global>
.checklist-dl {
  margin: 40px 0;
  padding: 28px 26px;
  background: var(--cream, #F3F1EB);
  border: 1px solid var(--ink-25, rgba(14, 14, 16, 0.1));
  border-radius: 14px;
}
.checklist-dl-title {
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  font-size: 1.25rem;
  letter-spacing: -0.4px;
  line-height: 1.25;
  color: var(--ink, #0E0E10);
  margin: 0 0 10px;
}
.checklist-dl-line {
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  line-height: 1.6;
  color: var(--ink-60, rgba(14, 14, 16, 0.6));
  margin: 0 0 18px;
  max-width: 52ch;
}
.checklist-dl-form {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: stretch;
}
.checklist-dl-input {
  flex: 1 1 200px;
  min-width: 0;
  padding: 12px 14px;
  border: 1px solid var(--ink-25, rgba(14, 14, 16, 0.12));
  border-radius: 10px;
  background: var(--white, #FCFCFC);
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  color: var(--ink, #0E0E10);
}
.checklist-dl-input:focus {
  outline: 2px solid rgba(154, 136, 253, 0.45);
  outline-offset: 1px;
  border-color: var(--purple, #9A88FD);
}
.checklist-dl-btn {
  flex: 0 0 auto;
  padding: 12px 18px;
  border: none;
  border-radius: 999px;
  background: var(--ink, #0E0E10);
  color: var(--white, #FCFCFC);
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}
.checklist-dl-btn:hover:not(:disabled) {
  background: var(--purple, #9A88FD);
  color: var(--ink, #0E0E10);
}
.checklist-dl-btn:disabled {
  opacity: 0.65;
  cursor: wait;
}
.checklist-dl-note {
  margin: 12px 0 0;
  font-size: 12.5px;
  color: var(--ink-60, rgba(14, 14, 16, 0.55));
}
.checklist-dl-error {
  margin: 10px 0 0;
  font-size: 13.5px;
  color: #c0392b;
}
.checklist-dl-success-msg {
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  line-height: 1.55;
  color: var(--ink, #0E0E10);
  margin: 0 0 14px;
}
.checklist-dl-link {
  display: inline-flex;
  align-items: center;
  padding: 12px 18px;
  border-radius: 999px;
  background: var(--ink, #0E0E10);
  color: var(--white, #FCFCFC) !important;
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none !important;
  transition: background 0.2s, transform 0.2s;
}
.checklist-dl-link:hover {
  background: var(--purple, #9A88FD);
  color: var(--ink, #0E0E10) !important;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
@media (max-width: 520px) {
  .checklist-dl { padding: 22px 18px; }
  .checklist-dl-btn { width: 100%; }
}
</style>

<script is:inline define:vars={{ GOOGLE_ADS_ID, GOOGLE_ADS_LEAD_LABEL, PDF_HREF }}>
(function () {
  var PDF = PDF_HREF;

  function showSuccess(root, ok) {
    var formWrap = root.querySelector('[data-checklist-form]');
    var success = root.querySelector('[data-checklist-success]');
    var msg = root.querySelector('[data-checklist-success-msg]');
    if (!formWrap || !success || !msg) return;
    formWrap.hidden = true;
    success.hidden = false;
    msg.textContent = ok
      ? 'Sent. And here it is right away:'
      : "The email didn't go through, but the checklist is yours:";
  }

  function wire(root) {
    if (!root || root.dataset.checklistWired === '1') return;
    root.dataset.checklistWired = '1';
    var form = root.querySelector('[data-checklist-form-el]');
    var input = root.querySelector('[data-checklist-email]');
    var btn = root.querySelector('[data-checklist-btn]');
    var err = root.querySelector('[data-checklist-error]');
    if (!form || !input || !btn) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = (input.value || '').trim();
      var re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!re.test(email)) {
        if (err) {
          err.hidden = false;
          err.textContent = 'Please enter a valid email.';
        }
        return;
      }
      if (err) err.hidden = true;
      btn.disabled = true;
      var original = btn.textContent;
      btn.textContent = '...';

      var eventId = (window.crypto && window.crypto.randomUUID)
        ? window.crypto.randomUUID()
        : String(Date.now()) + Math.random().toString(16).slice(2);

      var ok = false;
      try {
        var r = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: email,
            source: 'checklist',
            eventId: eventId,
            eventSourceUrl: window.location.href,
          }),
        });
        ok = !!r.ok;

        if (ok && typeof window.fbq === 'function') {
          window.fbq('track', 'Lead', { content_name: 'checklist_download' }, { eventID: eventId });
        }
        if (ok && typeof window.gtag === 'function' && GOOGLE_ADS_ID && GOOGLE_ADS_LEAD_LABEL) {
          window.gtag('set', 'user_data', { email: email });
          window.gtag('event', 'conversion', {
            send_to: GOOGLE_ADS_ID + '/' + GOOGLE_ADS_LEAD_LABEL,
            transaction_id: eventId,
          });
        }
      } catch (e) {
        ok = false;
      }

      showSuccess(root, ok);
      btn.disabled = false;
      btn.textContent = original;
    });
  }

  function placeCloneAfterSecondH2() {
    var prose = document.querySelector('.blog-prose');
    var primary = document.querySelector('[data-checklist-download]');
    if (!prose || !primary) return;
    var h2s = prose.querySelectorAll('h2');
    if (h2s.length < 2) return;
    if (document.querySelector('[data-checklist-download-mid]')) return;
    var clone = primary.cloneNode(true);
    clone.setAttribute('data-checklist-download-mid', '1');
    // Re-id email input to avoid duplicate IDs
    var emailInput = clone.querySelector('[data-checklist-email]');
    var label = clone.querySelector('label[for="checklist-email"]');
    if (emailInput) {
      emailInput.id = 'checklist-email-mid';
      if (label) label.setAttribute('for', 'checklist-email-mid');
    }
    h2s[1].insertAdjacentElement('afterend', clone);
    wire(clone);
  }

  function init() {
    document.querySelectorAll('[data-checklist-download]').forEach(wire);
    placeCloneAfterSecondH2();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
