---
/**
 * Click-to-load Supademo iframe (facade pattern).
 * Hub-card grammar + lime play affordance.
 */
interface Props {
  demoId: string;
  label?: string;
}

const {
  demoId,
  label = 'Watch the full flow · 2 min',
} = Astro.props;

const embedUrl = `https://app.supademo.com/embed/${demoId}?embed_v=2`;
const uid = `sd-${demoId.slice(0, 8)}`;
---

<div class="sd-embed" data-sd-root data-sd-url={embedUrl} id={uid}>
  <button type="button" class="sd-facade" data-sd-facade aria-label={`Play demo: ${label}`}>
    <span class="sd-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <polygon points="8 5 20 12 8 19 8 5"></polygon>
      </svg>
    </span>
    <span class="sd-label">{label}</span>
  </button>
</div>

<style>
.sd-embed {
  position: relative;
  width: 100%;
  margin: 1.5rem 0 2rem;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(14, 14, 16, 0.1);
  background: #fcfcfc;
  aspect-ratio: 16 / 10;
  min-height: 220px;
}
.sd-facade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 24px;
  border: 0;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  text-align: center;
  font: inherit;
  color: #0e0e10;
  background:
    radial-gradient(ellipse 70% 50% at 50% 40%, rgba(202, 254, 135, 0.35) 0%, transparent 70%),
    linear-gradient(160deg, #fcfcfc 0%, #f3f1eb 100%);
  transition: border-color 0.2s, transform 0.2s;
}
.sd-facade:hover .sd-play {
  transform: scale(1.06);
  box-shadow: 0 10px 28px rgba(202, 254, 135, 0.45);
}
.sd-play {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: #cafe87;
  color: #1a2e0a;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  padding-left: 3px;
}
.sd-label {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: -0.2px;
  color: #0e0e10;
}
.sd-iframe-wrap {
  position: absolute;
  inset: 0;
  background: #0e0e10;
}
.sd-iframe-wrap iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}
</style>

<script>
  function mountSupademo(root: HTMLElement) {
    const url = root.dataset.sdUrl;
    const facade = root.querySelector('[data-sd-facade]');
    if (!url || !facade || root.dataset.sdMounted === '1') return;
    facade.addEventListener('click', () => {
      if (root.dataset.sdMounted === '1') return;
      root.dataset.sdMounted = '1';
      root.innerHTML = `
        <div class="sd-iframe-wrap">
          <iframe
            src="${url}"
            title="Snagify interactive demo"
            loading="lazy"
            allow="clipboard-write"
            allowfullscreen
          ></iframe>
        </div>
      `;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-sd-root]').forEach(mountSupademo);
</script>
