---
import type { HubCard } from '../lib/resources';
import CategoryBadge from './CategoryBadge.astro';
import { formatBlogDate } from '../lib/resources';

interface Props {
  card: HubCard;
}

const { card } = Astro.props;
---

<section class="next-tutorial" aria-labelledby="next-tutorial-heading">
  <h2 class="next-tutorial-heading" id="next-tutorial-heading">Next up</h2>
  <a class="next-tutorial-card" href={card.href}>
    <CategoryBadge category="tutorial" />
    <h3 class="next-tutorial-title">{card.title}</h3>
    <p class="next-tutorial-desc">{card.description}</p>
    <div class="next-tutorial-meta">
      <time datetime={card.pubDate.toISOString()}>{formatBlogDate(card.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{card.readingMinutes} min read</span>
      <span class="next-tutorial-arrow" aria-hidden="true">→</span>
    </div>
  </a>
</section>

<style>
.next-tutorial {
  margin-top: 56px;
  padding-top: 40px;
  border-top: 1px solid rgba(14, 14, 16, 0.1);
}
.next-tutorial-heading {
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  font-size: 22px;
  letter-spacing: -0.5px;
  margin-bottom: 20px;
  color: #0e0e10;
}
.next-tutorial-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: #fcfcfc;
  border: 1px solid rgba(14, 14, 16, 0.1);
  border-radius: 16px;
  padding: 28px 28px 24px;
  text-decoration: none;
  color: inherit;
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.next-tutorial-card:hover {
  border-color: rgba(255, 143, 107, 0.55);
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(14, 14, 16, 0.06);
}
.next-tutorial-title {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: clamp(1.15rem, 2.5vw, 1.35rem);
  letter-spacing: -0.4px;
  line-height: 1.3;
  color: #0e0e10;
}
.next-tutorial-card:hover .next-tutorial-title {
  color: #9a88fd;
}
.next-tutorial-desc {
  font-size: 15px;
  line-height: 1.55;
  color: rgba(14, 14, 16, 0.6);
  max-width: 54ch;
}
.next-tutorial-meta {
  font-size: 12.5px;
  color: rgba(14, 14, 16, 0.6);
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 4px;
}
.next-tutorial-arrow {
  margin-left: auto;
  font-size: 16px;
  color: #ff8f6b;
}
</style>
