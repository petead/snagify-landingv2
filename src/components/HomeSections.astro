---
import { homeFaq } from '../lib/faq-content';

const waHref =
  'https://wa.me/971585169329?text=' +
  encodeURIComponent(
    'Hi Snagify, I would like you to do my report for me. My property (size, furnished or not): ',
  );

const demoUrl = 'https://app.supademo.com/embed/cmritt3p707ubqmeq7y0sx805?embed_v=2';
---

<style>
  .hs-why,
  .hs-how,
  .hs-pricing,
  .hs-faq,
  .hs-final,
  .hs-agencies,
  .hs-remind,
  .hs-bar,
  .hs-demo {
    font-family: 'DM Sans', sans-serif;
    color: var(--ink);
  }

  .hs-wrap {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .hs-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--ink-60);
    margin-bottom: 16px;
  }
  .hs-kicker::before {
    content: '';
    width: 20px;
    height: 1.5px;
    background: var(--ink-60);
    border-radius: 0;
  }

  .hs-h2 {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: clamp(36px, 4vw, 58px);
    letter-spacing: -2px;
    line-height: 1.04;
    color: var(--ink);
  }
  .hs-h2 em {
    font-family: 'Poppins', sans-serif;
    font-style: italic;
    font-weight: 800;
    color: var(--purple);
  }
  .hs-lead {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--ink-60);
    max-width: 480px;
  }
  .hs-lead-gap { margin-top: 16px; }
  .hs-center { text-align: center; }
  .hs-kicker-on-ink { color: rgba(255, 255, 255, 0.55); }

  .hs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 30px;
    border-radius: 999px;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.2px;
    line-height: 1.2;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background 0.35s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s, color 0.35s;
  }
  .hs-btn-ink {
    background: var(--ink);
    color: var(--white);
  }
  .hs-btn-ink:hover {
    background: var(--purple);
    color: var(--ink);
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(154, 136, 253, 0.35);
  }
  .hs-btn-green {
    background: var(--green);
    color: var(--ink);
  }
  .hs-btn-green:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(202, 254, 135, 0.4);
  }
  .hs-btn-ghost {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink-25);
  }
  .hs-btn-ghost:hover {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .lift {
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s;
  }
  .lift:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(14, 14, 16, 0.1);
  }

  @supports (animation-timeline: view()) {
    .rv {
      animation: hsRv linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 18%;
    }
  }
  @keyframes hsRv {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rv,
    .lift {
      animation: none;
      transition: none;
    }
    .lift:hover {
      transform: none;
    }
  }

  /* ── Why ── */
  .hs-why {
    padding: 140px 0 80px;
    background: var(--cream);
  }
  .hs-why-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 64px;
    align-items: center;
  }
  .hs-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .hs-fact {
    background: var(--white);
    border: 1px solid var(--ink-25);
    border-radius: 18px;
    padding: 22px 20px;
  }
  .hs-fact b {
    display: block;
    font-family: 'Poppins', sans-serif;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
    margin-bottom: 8px;
  }
  .hs-fact span {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-60);
  }

  /* ── How ── */
  .hs-how {
    padding: 40px 0 140px;
    background: var(--cream);
  }
  .hs-how-head {
    max-width: 720px;
    margin-bottom: 40px;
  }
  .hs-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 56px;
  }
  .hs-step {
    background: var(--white);
    border: 1px solid var(--ink-25);
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .hs-step-shot {
    height: 248px;
    background: var(--cream-2);
    overflow: hidden;
    position: relative;
  }
  .hs-step-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }
  .hs-step-shot--sign img {
    object-position: center 78%;
  }
  .hs-step-shot--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cream-2);
  }
  .hs-step-body {
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hs-step-n {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--purple);
  }
  .hs-step-body h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.15;
  }
  .hs-step-body p {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--ink-60);
  }
  .hs-cases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .hs-case {
    background: var(--white);
    border: 1px solid var(--ink-25);
    border-radius: 22px;
    padding: 28px;
  }
  .hs-case h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.15;
    margin-bottom: 10px;
  }
  .hs-case p {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-60);
  }

  /* ── Pricing ── */
  .hs-pricing {
    padding: 140px 0;
    background: var(--white);
  }
  .hs-price-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 36px;
  }
  .hs-price {
    border: 1px solid var(--ink-25);
    border-radius: 28px;
    overflow: hidden;
    background: var(--cream);
    display: flex;
    flex-direction: column;
  }
  .hs-price-banner {
    height: 180px;
    overflow: hidden;
  }
  .hs-price-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .hs-price-body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }
  .hs-price-body h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.1;
  }
  .hs-price-amt {
    font-family: 'Poppins', sans-serif;
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1;
  }
  .hs-price-body p {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-60);
  }
  .hs-price-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
  }
  .hs-photo-ph {
    margin: 8px 0 4px;
    min-height: 160px;
    border: 1.5px dashed var(--ink-25);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-60);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.4px;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 8px,
      rgba(14, 14, 16, 0.03) 8px,
      rgba(14, 14, 16, 0.03) 16px
    );
  }

  /* ── FAQ ── */
  .hs-faq {
    padding: 140px 0;
    background: var(--cream);
  }
  .hs-faq-list {
    max-width: 760px;
    margin: 28px auto 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hs-faq details {
    background: var(--white);
    border: 1px solid var(--ink-25);
    border-radius: 16px;
    padding: 0 22px;
  }
  .hs-faq summary {
    cursor: pointer;
    list-style: none;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 19px;
    line-height: 1.4;
    letter-spacing: -0.3px;
    padding: 22px 0;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    color: var(--ink);
  }
  .hs-faq summary::-webkit-details-marker {
    display: none;
  }
  .hs-faq summary::after {
    content: '+';
    font-size: 22px;
    font-weight: 600;
    color: var(--purple);
    flex-shrink: 0;
  }
  .hs-faq details[open] summary::after {
    content: '';
    width: 12px;
    height: 2px;
    background: var(--purple);
    margin-top: 0;
  }
  .hs-faq details p {
    font-family: 'DM Sans', sans-serif;
    padding: 0 0 22px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--ink-60);
  }

  /* ── Final ── */
  .hs-final {
    padding: 140px 0;
    background: var(--ink);
    color: var(--white);
  }
  .hs-final .hs-h2 {
    color: var(--white);
  }
  .hs-final .hs-lead {
    color: rgba(255, 255, 255, 0.62);
    margin: 16px 0 32px;
  }
  .hs-final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  .hs-final-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    color: var(--green);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Agencies ── */
  .hs-agencies {
    padding: 72px 0;
    background: var(--purple);
  }
  .hs-agencies-row {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: center;
  }
  .hs-agencies .hs-h2 {
    font-size: clamp(28px, 3.4vw, 40px);
  }
  .hs-agencies .hs-lead {
    color: var(--ink);
    margin-top: 8px;
  }

  /* ── Remind ── */
  .hs-remind {
    padding: 80px 0 100px;
    background: var(--cream);
  }
  .hs-remind-card {
    background: var(--white);
    border: 1px solid var(--ink-25);
    border-radius: 24px;
    padding: 36px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: center;
  }
  .hs-remind-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hs-remind-form input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--ink-25);
    background: var(--cream);
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: var(--ink);
  }
  .hs-remind-form input:focus {
    outline: 2px solid var(--purple);
    border-color: transparent;
  }
  .hs-remind-msg {
    font-size: 14px;
    font-weight: 600;
    min-height: 1.2em;
  }

  /* ── Demo overlay ── */
  .hs-demo {
    position: fixed;
    inset: 0;
    z-index: 20000;
    background: rgba(14, 14, 16, 0.72);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .hs-demo[hidden] {
    display: none;
  }
  .hs-demo-frame {
    position: relative;
    width: min(960px, 100%);
    aspect-ratio: 16 / 10;
    background: #0e0e10;
    border-radius: 16px;
    overflow: visible;
  }
  .hs-demo-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 16px;
  }
  .hs-demo-close {
    position: absolute;
    top: -44px;
    right: 0;
    background: var(--white);
    border: none;
    border-radius: 999px;
    padding: 8px 14px;
    font-weight: 700;
    cursor: pointer;
  }

  /* ── Phone bar ── */
  .hs-bar {
    display: flex;
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 900;
    align-items: center;
    gap: 10px;
    padding: 10px;
    background: rgba(243, 241, 235, 0.94);
    backdrop-filter: blur(16px);
    border: 1px solid var(--ink-25);
    border-radius: 999px;
    box-shadow: 0 12px 32px rgba(14, 14, 16, 0.14);
  }
  .hs-bar[hidden] {
    display: none !important;
  }
  .hs-bar-cta {
    flex: 1;
    justify-content: center;
    padding: 12px 16px;
    font-size: 13px;
  }
  .hs-bar-wa {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 859px) {
    .hs-wrap {
      padding: 0 20px;
    }
    .hs-h2 {
      font-size: clamp(28px, 7.5vw, 40px);
      letter-spacing: -1.2px;
    }
    .hs-why,
    .hs-how,
    .hs-pricing,
    .hs-faq,
    .hs-final,
    .hs-remind {
      padding: 72px 0;
    }
    .hs-why-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .hs-why-copy {
      order: -1;
    }
    .hs-facts {
      grid-template-columns: 1fr 1fr;
    }
    .hs-steps {
      grid-template-columns: 1fr;
    }
    .hs-step {
      flex-direction: row;
      align-items: stretch;
    }
    .hs-step-shot {
      width: 104px;
      height: 132px;
      flex-shrink: 0;
    }
    .hs-step-body {
      padding: 14px 14px 14px 16px;
      justify-content: center;
    }
    .hs-step-body h3 {
      font-size: 16px;
    }
    .hs-cases,
    .hs-price-grid,
    .hs-remind-card,
    .hs-agencies-row {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: stretch;
    }
    .hs-price-banner {
      display: none;
    }
    .hs-btn,
    .hs-price-actions .hs-btn,
    .hs-final-actions .hs-btn {
      width: 100%;
    }
    :global(body) {
      padding-bottom: 84px;
    }
    .hs-final-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<!-- ╔══ WHY ══╗ -->
<section class="hs-why" id="why" data-block="why">
  <div class="hs-wrap hs-why-grid">
    <div class="hs-facts rv">
      <article class="hs-fact lift">
        <b>Free</b>
        <span>Your move-in report costs nothing.</span>
      </article>
      <article class="hs-fact lift">
        <b>20 min</b>
        <span>Photograph every room, then sign.</span>
      </article>
      <article class="hs-fact lift">
        <b>Both sign</b>
        <span>On your phone, or from an email link.</span>
      </article>
      <article class="hs-fact lift">
        <b>PDF you keep</b>
        <span>Hashed, timestamped, downloadable anytime.</span>
      </article>
    </div>
    <div class="hs-why-copy rv">
      <div class="hs-kicker">Why a signed report</div>
      <h2 class="hs-h2">The only proof that counts when the deposit is on the line.</h2>
      <p class="hs-lead hs-lead-gap">
        Photos sitting in a camera roll are easy to dismiss. A move-in report that both parties signed is not. File it in twenty minutes, keep it for the whole tenancy.
      </p>
    </div>
  </div>
</section>

<!-- ╔══ HOW ══╗ -->
<section class="hs-how" id="how-it-works" data-block="how">
  <div class="hs-wrap">
    <div class="hs-how-head rv">
      <div class="hs-kicker">How it works</div>
      <h2 class="hs-h2">Three steps. Twenty minutes. <em>Both signatures.</em></h2>
    </div>

    <div class="hs-steps">
      <article class="hs-step lift rv">
        <div class="hs-step-shot">
          <img src="/screenshots/hiw-02-photo.png" alt="" width="720" height="1280" loading="lazy" />
        </div>
        <div class="hs-step-body">
          <span class="hs-step-n">Step 1</span>
          <h3>Photograph every room</h3>
          <p>Walk the property once. Each photo is timestamped and stored with the room it belongs to.</p>
        </div>
      </article>

      <article class="hs-step lift rv">
        <div class="hs-step-shot hs-step-shot--sign">
          <img src="/screenshots/hiw-03-signature.png" alt="" width="720" height="1280" loading="lazy" />
        </div>
        <div class="hs-step-body">
          <span class="hs-step-n">Step 2</span>
          <h3>Both parties sign</h3>
          <p>They sign on your phone, or from an email link on their own device. No account required.</p>
        </div>
      </article>

      <article class="hs-step lift rv">
        <!-- TODO: hide feat-pdf.png; a crop of the lower page still shows Creek Residences and person names -->
        <div class="hs-step-shot hs-step-shot--empty" aria-hidden="true"></div>
        <div class="hs-step-body">
          <span class="hs-step-n">Step 3</span>
          <h3>Keep the signed PDF</h3>
          <p>Download it the same day. The file is hashed so neither side can quietly edit it later.</p>
        </div>
      </article>
    </div>

    <div class="hs-cases" data-block="cases">
      <article class="hs-case rv" id="moved-in">
        <h3>Already living there?</h3>
        <p>
          You can still file a free move-in report. Do it this week, while the rooms still look like they did on day one. A baseline signed mid-tenancy is weaker than one signed at handover, and it is far stronger than photos with no signature at all.
        </p>
      </article>
      <article class="hs-case rv" id="moving-out">
        <h3>Moving out soon?</h3>
        <p>
          A move-out report is a room-by-room comparison against a signed Snagify move-in report on the same tenancy. Paper or Word files cannot be used as that baseline. If the tenancy is still running, file the free move-in report now.
        </p>
      </article>
    </div>
  </div>
</section>

<!-- ╔══ PRICING ══╗ -->
<section class="hs-pricing" id="pricing" data-block="pricing">
  <div class="hs-wrap">
    <div class="rv">
      <div class="hs-kicker">Pricing</div>
      <h2 class="hs-h2">Free to start. Pay only if you need the move-out report.</h2>
    </div>

    <div class="hs-price-grid">
      <article class="hs-price lift rv">
        <div class="hs-price-banner">
          <img src="/screenshots/feat-ai-analysis.png" alt="" width="1200" height="800" loading="lazy" />
        </div>
        <div class="hs-price-body">
          <h3>Do it yourself</h3>
          <div class="hs-price-amt">Free</div>
          <p>
            Photograph every room, both sign, keep the PDF. You only pay if you later lock a move-out report on that same tenancy. An apartment up to two bedrooms is two credits. Credits never expire.
          </p>
          <div class="hs-price-actions">
            <a class="hs-btn hs-btn-ink" href="https://app.snagify.net/signup?ref=home-pricing">Start my free move-in report</a>
            <button type="button" class="hs-btn hs-btn-ghost" data-home-demo>Try the demo</button>
          </div>
        </div>
      </article>

      <article class="hs-price lift rv" id="on-site">
        <div class="hs-price-body">
          <h3>By Snagify</h3>
          <div class="hs-price-amt">From AED 349</div>
          <p>
            A Snagify specialist comes to the property, photographs every room, and gets both signatures. Book a slot, or message us with the size and whether it is furnished.
          </p>
          <!-- TODO: replace [YOUR PHOTO] with a photo of a Snagify specialist at a property -->
          <div class="hs-photo-ph">[YOUR PHOTO]</div>
          <div class="hs-price-actions">
            <a class="hs-btn hs-btn-green" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp us</a>
            <a class="hs-btn hs-btn-ghost" href="#remind">Get a reminder</a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ╔══ FAQ ══╗ -->
<section class="hs-faq" id="faq" data-block="faq">
  <div class="hs-wrap">
    <div class="rv hs-center">
