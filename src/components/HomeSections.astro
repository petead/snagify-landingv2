<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { identifyOpenAIEmail, measureOpenAI } from '../scripts/openaiPixel';

  const GOOGLE_ADS_ID = String(import.meta.env.PUBLIC_GOOGLE_ADS_ID ?? '').trim();
  const GOOGLE_ADS_LEAD_LABEL = String(import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_LABEL ?? '').trim();

  type AdsWindow = Window & {
    fbq?: (...args: unknown[]) => void;
    gtag?: (...args: unknown[]) => void;
  };

  const demoUrl = 'https://app.supademo.com/embed/cmritt3p707ubqmeq7y0sx805?embed_v=2';
  const overlay = document.getElementById('home-demo');
  const frame = overlay?.querySelector('.hs-demo-frame');

  function closeDemo() {
    if (!overlay || !frame) return;
    overlay.hidden = true;
    frame.querySelector('iframe')?.remove();
  }

  document.querySelectorAll('[data-home-demo]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!overlay || !frame || frame.querySelector('iframe')) {
        if (overlay) overlay.hidden = false;
        return;
      }
      const iframe = document.createElement('iframe');
      iframe.src = demoUrl;
      iframe.title = 'Snagify interactive demo';
      iframe.allow = 'clipboard-write';
      iframe.setAttribute('allowfullscreen', '');
      frame.appendChild(iframe);
      overlay.hidden = false;
    });
  });
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeDemo();
  });
  document.querySelector('[data-home-demo-close]')?.addEventListener('click', closeDemo);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDemo();
  });

  const bar = document.getElementById('home-bar');
  function syncBar() {
    if (!bar) return;
    const phone = window.innerWidth < 860;
    const show = phone && window.scrollY > 560;
    bar.hidden = !show;
  }
  window.addEventListener('scroll', syncBar, { passive: true });
  window.addEventListener('resize', syncBar);
  syncBar();

  const form = document.getElementById('remind-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('remind-email') as HTMLInputElement | null;
  const dateInput = document.getElementById('remind-date') as HTMLInputElement | null;
  const msg = document.getElementById('remind-msg');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!emailInput || !dateInput || !submitBtn) return;
    const email = (emailInput.value || '').trim();
    const date = (dateInput.value || '').trim();
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!re.test(email) || !date) {
      if (msg) {
        msg.textContent = 'Please enter a valid email and date.';
        msg.style.color = '#FF5252';
      }
      return;
    }
    submitBtn.disabled = true;
    const original = submitBtn.textContent;
    submitBtn.textContent = '...';
    try {
      const w = window as AdsWindow;
      const eventId =
        window.crypto && window.crypto.randomUUID
          ? window.crypto.randomUUID()
          : String(Date.now()) + Math.random().toString(16).slice(2);

      const r = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          source: 'move-in-reminder:' + date,
          eventId,
          eventSourceUrl: window.location.href,
        }),
      });

      if (r.ok && typeof w.fbq === 'function') {
        w.fbq('track', 'Lead', { content_name: 'move-in-reminder' }, { eventID: eventId });
      }
      if (r.ok && typeof w.gtag === 'function' && GOOGLE_ADS_ID && GOOGLE_ADS_LEAD_LABEL) {
        w.gtag('set', 'user_data', { email });
        w.gtag('event', 'conversion', {
          send_to: GOOGLE_ADS_ID + '/' + GOOGLE_ADS_LEAD_LABEL,
          transaction_id: eventId,
        });
      }
      if (r.ok) {
        await identifyOpenAIEmail(email);
        measureOpenAI('lead_created', {}, { event_id: eventId });
        if (msg) {
          msg.textContent = 'Done. We will email you the day before.';
          msg.style.color = '#4A8A00';
        }
        emailInput.value = '';
        dateInput.value = '';
      } else if (msg) {
        msg.textContent = 'Something went wrong. Try again.';
        msg.style.color = '#FF5252';
      }
    } catch {
      if (msg) {
        msg.textContent = 'Network error. Try again.';
        msg.style.color = '#FF5252';
      }
    }
    submitBtn.disabled = false;
    submitBtn.textContent = original;
  });
</script>
