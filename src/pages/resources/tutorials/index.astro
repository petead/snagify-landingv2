---
import ResourcesLayout from '../../../layouts/ResourcesLayout.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import { getPublishedResources, toHubCard } from '../../../lib/resources';

const site = Astro.site?.origin ?? 'https://snagify.net';
const title = 'Tutorials | Snagify Resources';
const description =
  'Step-by-step Snagify tutorials: check-ins, photos, remote signatures, and check-out comparisons.';
const canonical = `${site}/resources/tutorials`;
const cards = (await getPublishedResources('tutorial')).map(toHubCard);
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources' },
  { name: 'Tutorials' },
];
---
<ResourcesLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}>
  <header class="rh-head">
    <p class="rh-eyebrow">Tutorials</p>
    <h1>Tutorials</h1>
    <p class="rh-sub">Short, practical walkthroughs for running inspections in Snagify.</p>
  </header>
  {cards.length === 0 ? (
    <p class="rh-empty">Tutorials are on the way — check back soon.</p>
  ) : (
    <div class="rh-grid">
      {cards.map((card) => (
        <ResourceCard card={card} />
      ))}
    </div>
  )}
</ResourcesLayout>
