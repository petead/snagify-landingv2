.proof-vs-badge { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2; width: 52px; height: 52px; border-radius: 50%; background: #FEDE80; color: #0E0E10; display: flex; align-items: center; justify-content: center; font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 15px; box-shadow: 0 0 0 6px #0E0E10; }
.proof-case { display: flex; flex-direction: column; gap: 18px; padding: clamp(22px, 2.6vw, 32px); border-radius: 28px; background: rgba(252,252,252,0.05); border: 1px solid rgba(252,252,252,0.14); }
.proof-case-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 20px; }
.proof-case-head h3 { margin: 0; font-family: 'Poppins', sans-serif; font-weight: 800; font-size: clamp(21px, 2vw, 26px); letter-spacing: -0.025em; }
