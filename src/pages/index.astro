}

/* ── Mobile (≤768px) ── */
@media(max-width:768px) {

  /* Base */
  body              { cursor: auto; }
  .section-wrap     { padding: 0 20px; }
  .section-header   { margin-bottom: 36px; }
  .section-title    { font-size: clamp(28px, 7.5vw, 40px); letter-spacing: -1.2px; }
  h1, h2, h3       { word-break: break-word; overflow-wrap: break-word; hyphens: auto; }
  .section-sub      { font-size: 15px; }

  /* Sections, padding vertical réduit */
  .pain-section     { padding: 72px 0; }
  .for-pros-inner   { padding: 72px 0; }
  .for-private      { padding: 72px 0; }
  .features         { padding: 60px 0 80px; }
  .testi            { padding: 72px 0; }
  .pricing          { padding: 72px 0; }

  /* Nav: tall on arrival, slightly shrinks when scrolled */
  #nav {
    padding: 16px 20px;
  }
  #nav.scrolled {
    top: 0;
    left: 0;
    right: 0;
    transform: none;
    width: 100%;
    max-width: none;
    border-radius: 0;
    padding: 10px 16px;
  }
  #nav.scrolled .nav-logo span { font-size: 16px; }
