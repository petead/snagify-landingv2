.fp-timeline { display:grid; grid-template-columns:1fr 1fr 1fr; gap:18px; position:relative; margin-bottom:58px; }
.fp-line { position:absolute; top:26px; left:14%; right:14%; height:2px; z-index:0;
  background:linear-gradient(90deg, var(--green) 0%, rgba(14,14,16,.1) 35%, rgba(14,14,16,.1) 65%, var(--jasmine) 100%); }
