}
.faq-a-inner { padding: 0 0 28px; max-width: 680px; }
.faq-a-inner:has(.faqx) { max-width: 760px; }
.faq-a p {
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-60);
}

.faq-bottom {
  margin-top: 48px;
  padding: 24px 28px;
  background: var(--purple-bg);
  border: 1px solid rgba(154,136,253,.25);
