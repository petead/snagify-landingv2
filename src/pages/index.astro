.bdg-good { background: var(--green-bg);   color: #4A8A00; }
.bdg-fair { background: var(--jasmine-bg); color: #8A6000; }

/* Card footer */
.ic-footer {
  padding: 14px 22px;
  background: var(--cream);
  border-top: 1px solid var(--ink-25);
  display: flex; align-items: center; justify-content: space-between;
}
.ic-progress {
  display: flex; flex-direction: column; gap: 4px;
}
.ic-progress-text { font-size: 11px; color: var(--ink-60); }
.ic-progress-bar { width: 120px; height: 4px; background: var(--ink-25); border-radius: 9px; overflow: hidden; }
.ic-progress-fill { height: 100%; width: 70%; background: var(--purple); border-radius: 9px; }

.ic-gen-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 14px; background: var(--ink); color: var(--white);
  font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 12px;
  border-radius: 999px; text-decoration: none;
}

/* Float tags around the card */
.hero-tag {
  position: absolute;
  background: var(--white); border-radius: 14px;
  padding: 9px 14px;
  display: flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 600;
  box-shadow:
    0 12px 40px rgba(14,14,16,.12),
    0 2px 8px rgba(14,14,16,.06),
    inset 0 1px 0 rgba(255,255,255,.9);
  border: 1px solid var(--ink-25); white-space: nowrap; z-index: 3;
  opacity: 0; animation: fadeInTag .6s cubic-bezier(.16,1,.3,1) forwards;
}
.ht1 { top: 30px; left: -50px; animation-delay: 1.6s; }
.ht2 { top: 50%; right: -60px; animation-delay: 1.9s; transform: translateY(-50%); }
.ht3 { bottom: 60px; left: -40px; animation-delay: 2.1s; }
@keyframes fadeInTag {
  from { opacity: 0; transform: translateY(12px) scale(.95); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.ht2 { animation-name: fadeInTagRight; }
@keyframes fadeInTagRight {
  from { opacity: 0; transform: translateY(-50%) translateX(12px) scale(.95); }
  to   { opacity: 1; transform: translateY(-50%) translateX(0) scale(1); }
}

.htag-ico {
  width: 26px; height: 26px; border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.htag-ico svg { width: 13px; height: 13px; }

/* ── Shared animations ── */
@keyframes fadeIn { to { opacity: 1; } }

/* ══ FOOTER ══ */
footer {
  background: var(--ink);
  padding: 80px 48px 40px;
  color: rgba(255,255,255,.55);
}
.footer-top {
  display: grid;
  grid-template-columns: 1.5fr repeat(4, 1fr);
  gap: 28px; margin-bottom: 56px;
}
.foot-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.foot-brand p {
  font-size: 14px; line-height: 1.75;
  margin-top: 14px; max-width: 300px;
  color: rgba(255,255,255,.45);
}
.foot-badge {
  display: inline-flex; align-items: center; gap: 7px;
  margin-top: 16px;
  font-size: 11px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 2px;
  color: rgba(255,255,255,.65);
}
.foot-badge svg { opacity: .75; }
.foot-col h4 {
  font-family: 'Poppins', sans-serif;
  font-weight: 700; font-size: 13px;
  color: var(--white); margin-bottom: 18px;
  text-transform: uppercase; letter-spacing: 1.5px;
}
.foot-col ul {
  list-style: none;
  display: flex; flex-direction: column; gap: 10px;
}
.foot-col a {
  color: rgba(255,255,255,.6); text-decoration: none;
  font-size: 14px; transition: color .25s;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}
.foot-col a:hover { color: var(--purple); }
.footer-bottom {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,.06);
  gap: 16px; flex-wrap: wrap;
}
.footer-bottom p { font-size: 13px; color: rgba(255,255,255,.6); max-width: 46rem; line-height: 1.5; }
.footer-bottom a { color: inherit; }
.foot-socials { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.foot-socials a {
  width: 40px; height: 40px; border-radius: 10px;
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.07);
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,.4); text-decoration: none;
  transition: all .25s;
}
.foot-socials a:hover {
  background: var(--purple); color: var(--ink);
  border-color: var(--purple);
}
.foot-chat-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 16px; border-radius: 999px; border: none; cursor: pointer;
  background: var(--purple); color: var(--ink);
  font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600;
  transition: transform .2s, box-shadow .2s;
}
.foot-chat-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(154,136,253,.35);
}
.foot-ph {
  display: flex;
  margin-top: 14px;
  transition: transform .25s ease, opacity .25s ease;
}
.foot-ph:hover { transform: translateY(-2px); opacity: .92; }
.foot-ph img { display: block; width: auto; height: 53px; }

@media(max-width: 1100px) {
  .footer-top { grid-template-columns: 1fr 1fr; }
}
@media(max-width: 768px) {
  footer { padding: 60px 20px 32px; }
  .footer-top { grid-template-columns: 1fr; gap: 36px; }
  .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }
}

/* ══════════════════════════════════
   SCROLL REVEALS
══════════════════════════════════ */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity .75s cubic-bezier(.16,1,.3,1), transform .75s cubic-bezier(.16,1,.3,1); }
.reveal.in { opacity: 1; transform: translateY(0); }
.reveal-delay-1 { transition-delay: .12s; }
.reveal-delay-2 { transition-delay: .22s; }
.reveal-delay-3 { transition-delay: .34s; }

/* ══════════════════════════════════════════════
   MOBILE OPTIMIZATION, override global
   Deux breakpoints : ≤1100px (tablet) · ≤768px (mobile)
══════════════════════════════════════════════ */

/* ── Tablet (769px-1100px) ── */
@media(max-width:1100px) {

  /* Base */
  .section-wrap     { padding: 0 32px; }

  /* Hero */
  .hero             { padding: 120px 32px 80px; }
  .hero-inner       { grid-template-columns: 1fr; gap: 60px; }
  .hero-right       { justify-content: center; padding: 0 !important; }
  .hero-right::before { display: none; }
  .hero-watermark   { display: none; }
  .hero-tag         { display: none; }
  .insp-card-back   { display: none; }
  @keyframes cardReveal { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }







  /* Footer */
  .footer-top       { grid-template-columns: 1fr 1fr; gap: 40px; }
}

/* ── Mobile (≤768px) ── */
@media(max-width:768px) {

  /* Base */
  body              { cursor: auto; }
  .section-wrap     { padding: 0 20px; }
  h1, h2, h3       { word-break: break-word; overflow-wrap: break-word; hyphens: auto; }

  /* Nav: tall on arrival, slightly shrinks when scrolled */
  #nav {
    padding: 16px 20px;
  }
  #nav.scrolled {
    top: 0;
    left: 0;
    right: 0;
    transform: none;
    width: 100%;
    max-width: none;
    border-radius: 0;
    padding: 10px 16px;
  }
  #nav.scrolled .nav-logo span { font-size: 16px; }
  #nav.scrolled .nav-logo svg { width: 28px; height: 28px; }
  .nav-links { display: none; }
  .nav-actions { display: flex; }
  .nav-burger { display: flex; }
  .nav-app-mobile {
    display: inline-flex !important;
    padding: 8px 12px !important;
    font-size: 12px !important;
    gap: 6px !important;
  }
  .nav-pill.nav-app-mobile { display: inline-flex !important; }
  .nav-pill-start { padding: 8px 14px !important; font-size: 12px !important; }

  /* Hero */
  .hero             { padding: 92px 20px 56px; min-height: auto; }
  .hero-inner       { grid-template-columns: 1fr; gap: 32px; }
  .hero-right       { display: none; }
  .hero-right::before { display: none; }
  .hero h1          { font-size: clamp(46px, 11vw, 62px); letter-spacing: -2px; }
  .hero h1 .line-inner {
    transform: none !important;
    animation: none !important;
  }
  .hero-eyebrow     { flex-wrap: wrap; gap: 4px; font-size: 10px; letter-spacing: 2.5px; }
  .hero-watermark   { display: none; }
  .hero-tag         { display: none; }
  .hero-desc        { font-size: 15px; margin-bottom: 32px; }
  .hero-actions     { gap: 10px; width: 100%; }
  .btn-ink { padding: 13px 24px; font-size: 14px; justify-content: center; }
  .hero-cta-group { display: flex; flex-direction: column; width: 100%; align-items: stretch; }
  .hero-cta-group .btn-ink { padding: 13px 24px; font-size: 14px; width: 100%; justify-content: center; }
  .insp-card        { transform: rotate(0deg) !important; animation: none !important; }
  .insp-card-back   { display: none; }

  /* Footer */
  footer            { padding: 56px 20px 28px; }
  .footer-top       { grid-template-columns: 1fr; gap: 32px; margin-bottom: 40px; }
  .footer-bottom    { flex-direction: column; gap: 14px; text-align: center; }
}

