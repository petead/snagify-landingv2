  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.faq-bottom-text h4 {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 17px;
  color: var(--ink);
  margin: 0 0 4px;
}
.faq-bottom-text p {
  font-size: 14px;
  color: var(--ink-60);
  margin: 0;
}
.faq-bottom-actions { display: flex; gap: 10px; flex-wrap: wrap; }

.faq-btn {
  padding: 12px 20px;
  border-radius: 999px;
