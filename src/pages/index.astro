  .nav-links { display: none; }
  .nav-account { display: none; }
  .nav-actions { display: flex; }
  .nav-burger { display: flex; }
  .nav-app-mobile {
    padding: 8px 12px !important;
    font-size: 12px !important;
    gap: 6px !important;
  }

  /* Hero */
  .hero             { padding: 92px 20px 56px; min-height: auto; }
  .hero-inner       { grid-template-columns: 1fr; gap: 32px; }
  .hero-right       { display: none; }
  .hero-right::before { display: none; }
  .hero h1          { font-size: clamp(46px, 11vw, 62px); letter-spacing: -2px; }
  .hero h1 .line-inner {
    transform: none !important;
    animation: none !important;
  }
  .hero-eyebrow     { flex-wrap: wrap; gap: 4px; font-size: 10px; letter-spacing: 2.5px; }
  .hero-watermark   { display: none; }
  .hero-tag         { display: none; }
  .hero-desc        { font-size: 15px; margin-bottom: 32px; }
  .hero-actions     { gap: 10px; width: 100%; }
  .btn-ink, .btn-ghost { padding: 13px 24px; font-size: 14px; justify-content: center; }
  .hero-cta-group { display: flex; flex-direction: column; width: 100%; align-items: stretch; }
  .hero-cta-group .btn-ink,
  .hero-cta-group .btn-ghost { padding: 13px 24px; font-size: 14px; width: 100%; justify-content: center; }
  .hero-service { align-self: flex-start; }
  .insp-card        { transform: rotate(0deg) !important; animation: none !important; }
  .insp-card-back   { display: none; }

  /* Pain */
  .pain-big-sub     { max-width: 100%; }
  .pain-big-num     { font-size: clamp(42px, 11vw, 56px); letter-spacing: -2px; }
  .pain-headline    { font-size: clamp(20px, 5.5vw, 26px); }

  /* For Pros */
  .for-pros-grid    { grid-template-columns: 1fr; gap: 32px; }
  .for-pros-right   { display: none; }
  .pros-features    { margin: 24px 0 32px; }
  .pros-cta         { flex-direction: column; align-items: stretch; gap: 12px; }
  .pros-cta .btn-pros-primary,
  .pros-cta .btn-pros-secondary { width: 100%; justify-content: center; }
  .pros-stars       { opacity: .55; }

  /* Bento */
  .bento-card       { border-radius: 20px; }

  /* Testimonials: swipe carousel, not a tall stack */
  .testi-grid,
  .testi-grid-2 {
    display: flex;
    grid-template-columns: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    gap: 12px;
    margin-bottom: 8px;
    padding: 2px 4px 12px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .testi-grid::-webkit-scrollbar,
  .testi-grid-2::-webkit-scrollbar { display: none; }
  .testi-card {
    flex: 0 0 min(82vw, 300px);
    scroll-snap-align: start;
    padding: 20px;
    border-radius: 18px;
  }
  .testi-text {
    font-size: 13.5px;
    line-height: 1.55;
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .testi-divider    { margin: 24px 0 20px; }
  .testi .testi-author { margin-top: 0; padding-top: 14px; }

  /* Pricing */
  .pricing-grid           { grid-template-columns: 1fr; }
  .pricing-toggle   { width: 100%; }
  .ptoggle-btn      { flex: 1; justify-content: center; font-size: 12px; padding: 10px 12px; gap: 5px; }
  .price-card       { padding: 28px; border-radius: 20px; }
  .price-num        { font-size: 40px; }

  /* CTA Final */
  .cta-band-top     { display: none; }
  .cta-inner        { grid-template-columns: 1fr; padding: 64px 20px; gap: 36px; }
  .btn-cta-primary, .btn-cta-ghost { width: 100%; justify-content: center; }
  .cta-divider-row  { width: 100%; }
  .cta-ghost-doc    { display: none; }
  .cta-inner h2     { font-size: clamp(38px, 9.5vw, 56px); letter-spacing: -2.5px; line-height: 1; }
  .cta-sub          { font-size: 15px; }
  .stay-informed    { max-width: 100%; }
  .stay-informed-btn { width: 100%; }
  .cta-seal         { grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px; }
  .cta-seal-title   { font-size: 11px; }
  .cta-pulse-ring   { display: none; }
  .cta-eyebrow      { font-size: 9px; }

  /* Footer */
  footer            { padding: 56px 20px 28px; }
  .footer-top       { grid-template-columns: 1fr; gap: 32px; margin-bottom: 40px; }
  .footer-bottom    { flex-direction: column; gap: 14px; text-align: center; }
}

