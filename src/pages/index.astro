<script>
// ── SVG INK FILTER (injecté dynamiquement) ──
(function() {
  const svgDefs = document.createElementNS('http://www.w3.org/2000/svg','svg');
  svgDefs.setAttribute('width','0'); svgDefs.setAttribute('height','0');
  svgDefs.style.cssText='position:absolute;pointer-events:none';
  svgDefs.innerHTML = `<defs>
    <filter id="ink-filter" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.0" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </defs>`;
  document.body.prepend(svgDefs);
})();

// ── SIGNATURE SCROLL TRIGGERS ──
function triggerSigOnScroll(pathId) {
  const path = document.getElementById(pathId);
  if (!path) return;
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        path.classList.remove('sig-animate');
        void path.getBoundingClientRect();
        path.classList.add('sig-animate');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.55 });
  obs.observe(path.closest('.b-sig-canvas') || path.closest('.hiw-phone') || path);
}

// ── CURSOR (desktop uniquement) ──
const cur = document.getElementById('cur');
const isTouch = window.matchMedia('(max-width: 1024px)').matches || ('ontouchstart' in window);
if (isTouch && cur) cur.style.display = 'none';

if (!isTouch && cur) {
  /**
   * Remonte les ancêtres d'un élément et retourne la première
   * backgroundColor non-transparente trouvée (format rgb/rgba).
   */
  function getEffectiveBg(el) {
    let node = el;
    while (node && node !== document.documentElement) {
      const bg = window.getComputedStyle(node).backgroundColor;
      if (bg && bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') return bg;
      node = node.parentElement;
    }
    return 'rgb(243,241,235)'; // fallback cream
  }

  /**
   * Calcule la luminance relative d'une couleur rgb/rgba.
   * Retourne true si le fond est sombre (luminance < 0.18).
   */
  function isDarkBg(cssColor) {
    const m = cssColor.match(/[\d.]+/g);
    if (!m || m.length < 3) return false;
    const [r, g, b] = [+m[0], +m[1], +m[2]].map(v => {
      v /= 255;
      return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
    });
    const L = 0.2126 * r + 0.7152 * g + 0.0722 * b;
    return L < 0.18;
  }

  let lastDark = false;

  window.addEventListener('mousemove', e => {
    cur.style.left = e.clientX + 'px';
    cur.style.top  = e.clientY + 'px';

    const el = document.elementFromPoint(e.clientX, e.clientY);
    if (el) {
      const bg = getEffectiveBg(el);
      const dark = isDarkBg(bg);
      if (dark !== lastDark) {
        cur.classList.toggle('light', dark);
        lastDark = dark;
      }
    }
  }, { passive: true });

  document.querySelectorAll('a, button').forEach(el => {
    el.addEventListener('mouseenter', () => cur.classList.add('big'));
    el.addEventListener('mouseleave', () => cur.classList.remove('big'));
  });
}

// ── SCROLL PROGRESS + NAV PILL ──
const prog = document.getElementById('prog');
const navEl = document.getElementById('nav');

window.addEventListener('scroll', () => {
  const scrolled = window.scrollY > 60;
  prog.style.width = (window.scrollY / (document.body.scrollHeight - innerHeight) * 100) + '%';

  if (scrolled && !navEl.classList.contains('scrolled')) {
    navEl.classList.add('scrolled');
  } else if (!scrolled && navEl.classList.contains('scrolled')) {
    navEl.classList.remove('scrolled');
  }
}, { passive: true });

// ── REVEAL ON SCROLL ──
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: .12 });
document.querySelectorAll('.reveal').forEach(r => io.observe(r));

const proofVs = document.querySelector('.proof-vs');
if (proofVs) {
  new IntersectionObserver((entries, obs) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      e.target.classList.add('play');
      obs.unobserve(e.target);
    });
  }, { threshold: 0.4, rootMargin: '-18% 0px -28% 0px' }).observe(proofVs);
}

// ── ANIMATED COUNTER ──
const ctr = document.getElementById('ctr');
let counted = false;
if (ctr) new IntersectionObserver(entries => {
  if (entries[0].isIntersecting && !counted) {
    counted = true;
    let n = 0;
    const end = 2400;
    const step = () => {
      n = Math.min(n + 48, end);
      ctr.textContent = n.toLocaleString() + '+';
      if (n < end) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
}, { threshold: 1 }).observe(ctr);

// ── SMOOTH ANCHOR ──
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const href = a.getAttribute('href');
    const t = document.querySelector(href);
    if (t) {
      e.preventDefault();
      setTimeout(() => t.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
    }
  });
});

// ── HAMBURGER MENU ──
(function() {
  function initHamburgerMenu() {
    var burger = document.getElementById('nav-burger');
    var drawer = document.getElementById('nav-drawer');
    var closeBtn = document.getElementById('drawer-close');
    if (!burger || !drawer) return;

    function open() {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      drawer.removeAttribute('inert');
      burger.classList.add('is-open');
      burger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      drawer.setAttribute('inert', '');
      burger.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    burger.addEventListener('click', function(e) {
      e.stopPropagation();
      drawer.classList.contains('is-open') ? close() : open();
    });
    if (closeBtn) closeBtn.addEventListener('click', close);
    drawer.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', close);
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') close();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHamburgerMenu);
  } else {
    initHamburgerMenu();
  }
})();

// Features deck: mobile swipe affordance (dots + hint + edge fade)
(() => {
  const root = document.querySelector('[data-deck-carousel]');
  const track = document.querySelector('[data-deck-track]');
  const dotsRoot = document.querySelector('[data-deck-dots]');
  const hint = document.querySelector('[data-deck-hint]');
  if (!root || !track || !dotsRoot) return;

  const mq = window.matchMedia('(max-width: 768px)');
  const slides = Array.from(track.querySelectorAll('.deck-slide'));
  if (slides.length < 2) return;

  let dots = [];
  let hintHidden = false;

  function buildDots() {
    dotsRoot.innerHTML = '';
    dots = slides.map((_, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'deck-dot' + (i === 0 ? ' is-active' : '');
      btn.setAttribute('aria-label', `Feature ${i + 1}`);
      btn.addEventListener('click', () => {
        slides[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
      dotsRoot.appendChild(btn);
      return btn;
    });
  }

  function activeIndex() {
    const left = track.scrollLeft;
    let best = 0;
    let bestDist = Infinity;
    slides.forEach((slide, i) => {
      const dist = Math.abs(slide.offsetLeft - left);
      if (dist < bestDist) {
        bestDist = dist;
        best = i;
      }
    });
    return best;
  }

  function sync() {
    if (!mq.matches) return;
    const i = activeIndex();
    dots.forEach((d, idx) => d.classList.toggle('is-active', idx === i));
    root.classList.toggle('is-end', i >= slides.length - 1);
    if (!hintHidden && track.scrollLeft > 12 && hint) {
      hint.hidden = true;
      hintHidden = true;
      track.classList.remove('is-nudge');
    }
  }

  function onFirstInteract() {
    track.classList.remove('is-nudge');
  }

  buildDots();
  sync();

  track.addEventListener('scroll', () => {
    window.requestAnimationFrame(sync);
  }, { passive: true });
  track.addEventListener('pointerdown', onFirstInteract, { once: true });
  track.addEventListener('touchstart', onFirstInteract, { once: true, passive: true });

  if (mq.matches) track.classList.add('is-nudge');
  mq.addEventListener('change', (e) => {
    if (e.matches) {
      if (!hintHidden) track.classList.add('is-nudge');
      sync();
    } else {
      track.classList.remove('is-nudge');
      root.classList.remove('is-end');
    }
  });
})();

