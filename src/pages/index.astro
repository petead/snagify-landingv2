}
@keyframes faqFadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.faq-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}
.faq-tab {
  padding: 10px 18px;
  border-radius: 999px;
  background: transparent;
  color: var(--ink-60);
  border: 1px solid var(--ink-25);
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all .25s cubic-bezier(.16,1,.3,1);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.faq-tab:hover {
  color: var(--ink);
  border-color: var(--ink);
}
.faq-tab.active {
  background: var(--purple);
  color: var(--ink);
  border-color: var(--purple);
  font-weight: 700;
}
.faq-tab-count {
  font-size: 11px;
  opacity: .55;
  font-weight: 700;
}
