  background:var(--cream); display:flex; align-items:center; justify-content:center; color:rgba(14,14,16,.4); z-index:1; }
.fp-chev svg { width:14px; height:14px; }

.fp-step { position:relative; z-index:1; text-align:center; padding:0 10px; }
.fp-dot { width:52px; height:52px; border-radius:50%; margin:0 auto 22px; display:flex; align-items:center; justify-content:center;
  background:var(--white); border:2px solid rgba(14,14,16,.1); box-shadow:0 6px 20px rgba(14,14,16,.06);
