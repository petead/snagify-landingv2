}
.faq-inner { max-width: 900px; margin: 0 auto; }

.faq-head { margin-bottom: 48px; }
.faq h2 {
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  font-size: clamp(36px, 5vw, 64px);
  line-height: 1.02;
  letter-spacing: -1.5px;
  margin: 18px 0 20px;
