<script>
import { identifyOpenAIEmail, measureOpenAI } from '../scripts/openaiPixel';

const GOOGLE_ADS_ID = String(import.meta.env.PUBLIC_GOOGLE_ADS_ID ?? '').trim();
const GOOGLE_ADS_LEAD_LABEL = String(import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_LABEL ?? '').trim();

type AdsWindow = Window & {
  fbq?: (...args: unknown[]) => void;
  gtag?: (...args: unknown[]) => void;
  oaiq?: (...args: unknown[]) => void;
};

(function() {
  const w = window as AdsWindow;
  const form = document.getElementById('si-form') as HTMLFormElement | null;
  const btn = document.getElementById('si-btn') as HTMLButtonElement | null;
  const input = document.getElementById('si-email') as HTMLInputElement | null;
  const dateInput = document.getElementById('si-date') as HTMLInputElement | null;
  const msg = document.getElementById('si-msg');
  if (!form || !btn || !input || !dateInput) return;

  function fail(text: string) {
    if (!msg) return;
    msg.textContent = text;
    (msg as HTMLElement).style.color = '#FF5252';
  }

  async function submit(e?: Event) {
    if (e) e.preventDefault();
    const email = (input.value || '').trim();
    const moveInDate = (dateInput.value || '').trim();
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!/^\d{2}\/\d{2}\/\d{4}$/.test(moveInDate)) {
      fail('Use the date format dd/mm/yyyy.');
      return;
    }
    if (!re.test(email)) {
      fail('Please enter a valid email.');
      return;
    }
    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = '...';
    try {
      const eventId = (window.crypto && window.crypto.randomUUID)
        ? window.crypto.randomUUID()
        : String(Date.now()) + Math.random().toString(16).slice(2);

      const r = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: email,
          moveInDate: moveInDate,
          source: 'reminder',
          eventId: eventId,
          eventSourceUrl: window.location.href,
        }),
      });
      const data = await r.json().catch(() => ({}));

      if (r.ok && typeof w.fbq === 'function') {
        w.fbq('track', 'Lead', { content_name: 'reminder' }, { eventID: eventId });
      }
      if (r.ok && typeof w.gtag === 'function' && GOOGLE_ADS_ID && GOOGLE_ADS_LEAD_LABEL) {
        w.gtag('set', 'user_data', { email: email });
        w.gtag('event', 'conversion', {
          send_to: GOOGLE_ADS_ID + '/' + GOOGLE_ADS_LEAD_LABEL,
          transaction_id: eventId,
        });
      }
      if (r.ok) {
        await identifyOpenAIEmail(email);
        measureOpenAI('lead_created', {}, { event_id: eventId });
      }
      if (r.ok) {
        if (msg) {
          msg.textContent = data.immediate
            ? "We'll email you now. Your move-in is tomorrow."
            : `Reminder set. We'll email you on ${data.remindOn}.`;
          (msg as HTMLElement).style.color = '#9A88FD';
        }
        input.value = '';
        dateInput.value = '';
      } else {
        fail(data.error || 'Something went wrong. Try again.');
      }
    } catch (e) {
      fail('Network error. Try again.');
    }
    btn.disabled = false;
    btn.textContent = original;
  }

  form.addEventListener('submit', submit);
})();
</script>
<script>
// FAQ v2, persona toggle + category tabs + accordion
(function(){
  const personas = document.querySelectorAll('.faq-persona-btn');
  const personaPanels = document.querySelectorAll('.faq-persona-panel');
  if (!personas.length) return;

  function closeItem(item) {
    item.classList.remove('open');
    const a = item.querySelector('.faq-a');
    if (a) a.style.maxHeight = '0px';
  }
  function openItem(item) {
    item.classList.add('open');
    const a = item.querySelector('.faq-a');
    if (a) a.style.maxHeight = a.scrollHeight + 'px';
  }

  personaPanels.forEach(pp => {
    const tabs = pp.querySelectorAll('.faq-tab');
    const panels = pp.querySelectorAll('.faq-panel');
    const items = pp.querySelectorAll('.faq-item');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach(t => t.classList.toggle('active', t === tab));
        panels.forEach(p => p.classList.toggle('active', p.dataset.panel === target));
        items.forEach(closeItem);
      });
    });

    items.forEach(item => {
      const q = item.querySelector('.faq-q');
      if (!q) return;
      q.addEventListener('click', () => {
        const wasOpen = item.classList.contains('open');
        const panel = item.closest('.faq-panel');
        panel.querySelectorAll('.faq-item.open').forEach(closeItem);
        if (!wasOpen) {
          openItem(item);
          requestAnimationFrame(() => {
            setTimeout(() => {
              const rect = item.getBoundingClientRect();
              const navH = 80;
              if (rect.top < navH) {
                const absoluteTop = window.scrollY + rect.top - navH - 16;
                window.scrollTo({ top: absoluteTop, behavior: 'smooth' });
              }
            }, 120);
          });
        }
      });
    });
  });

  personas.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.persona;
      personas.forEach(p => {
        const active = p === btn;
        p.classList.toggle('active', active);
        p.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      personaPanels.forEach(pp => {
        const active = pp.dataset.personaPanel === target;
        pp.classList.toggle('active', active);
        if (active) {
          pp.querySelectorAll('.faq-tab').forEach((t, i) => t.classList.toggle('active', i === 0));
          pp.querySelectorAll('.faq-panel').forEach((p, i) => p.classList.toggle('active', i === 0));
          pp.querySelectorAll('.faq-item').forEach(closeItem);
        }
      });
    });
  });

  function activateFaqPersona(persona) {
    const btn = document.querySelector('.faq-persona-btn[data-persona="' + persona + '"]');
    if (btn && !btn.classList.contains('active')) btn.click();
  }

  function activateFaqTab(personaPanel, tabName) {
    const pp = document.querySelector('.faq-persona-panel[data-persona-panel="' + personaPanel + '"]');
    if (!pp) return;
    const tab = pp.querySelector('.faq-tab[data-tab="' + tabName + '"]');
    if (tab) tab.click();
  }

  function openFaqFromHash() {
    const hash = window.location.hash;
    if (hash !== '#faq-checkout-cost' && hash !== '#faq-credits-pro') return;
    const item = document.querySelector(hash);
    if (!item) return;

    if (hash === '#faq-checkout-cost') {
      activateFaqPersona('landlords');
      activateFaqTab('landlords', 'pricing');
    } else if (hash === '#faq-credits-pro') {
      activateFaqPersona('pros');
      activateFaqTab('pros', 'pricing');
    }

    setTimeout(() => {
      const panel = item.closest('.faq-panel');
      const pp = item.closest('.faq-persona-panel');
      if (pp && panel) {
        const tabName = panel.dataset.panel;
        const tab = pp.querySelector('.faq-tab[data-tab="' + tabName + '"]');
        if (tab && !tab.classList.contains('active')) tab.click();
      }
      if (panel) panel.querySelectorAll('.faq-item.open').forEach(closeItem);
      openItem(item);
      setTimeout(() => {
        const rect = item.getBoundingClientRect();
        const navH = 96;
        window.scrollTo({ top: Math.max(0, window.scrollY + rect.top - navH - 16), behavior: 'smooth' });
      }, 150);
    }, 80);
  }

  document.querySelectorAll('.price-faq-link').forEach(link => {
    link.addEventListener('click', e => {
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#faq-')) return;
      e.preventDefault();
      if (window.location.hash !== href) {
        window.location.hash = href;
      } else {
        openFaqFromHash();
      }
    });
  });

  document.querySelectorAll('[data-faq-switch]').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-faq-switch');
      let hash = '';
      let persona = '';
      if (target === 'individual' || target === 'landlords') {
        hash = '#faq-checkout-cost';
        persona = 'landlords';
      } else if (target === 'pro' || target === 'pros') {
        hash = '#faq-credits-pro';
        persona = 'pros';
      } else {
        hash = '#' + (btn.getAttribute('data-faq-hash') || '');
        persona = target || '';
      }
      if (!hash || hash === '#') return;
      if (persona) activateFaqPersona(persona);
      if (window.location.hash !== hash) {
        window.location.hash = hash;
      } else {
        openFaqFromHash();
      }
    });
  });

  function faqxRefreshFaqHeight(root) {
    const item = root && root.closest('.faq-item');
    if (!item || !item.classList.contains('open')) return;
    const a = item.querySelector('.faq-a');
    if (a) a.style.maxHeight = a.scrollHeight + 'px';
  }

  function faqxWire(rootId, opts) {
    const root = document.getElementById(rootId);
    if (!root) return;
    const typeBtns = root.querySelectorAll('[data-role="type"] button');
    const furn = root.querySelector('[data-role="furn"]');
    const num = root.querySelector('[data-role="num"]');
    const unit = root.querySelector('[data-role="unit"]');
    let base = parseInt(root.querySelector('[data-role="type"] button.on').dataset.base, 10);
    let furnished = false;
    function render() {
      const total = base + (furnished ? opts.addon : 0);
      num.textContent = total;
      num.classList.add('pop');
      setTimeout(function () { num.classList.remove('pop'); }, 150);
      unit.textContent = (total === 1 ? 'credit' : 'credits') + (opts.each ? ' each' : '');
      faqxRefreshFaqHeight(root);
    }
    typeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        typeBtns.forEach(function (b) { b.classList.remove('on'); });
        btn.classList.add('on');
        base = parseInt(btn.dataset.base, 10);
        render();
      });
    });
    furn.addEventListener('click', function () {
      furnished = !furnished;
      furn.classList.toggle('on', furnished);
      render();
    });
    render();
  }
  faqxWire('faqxCalcPro', { addon: 1, each: true });
  faqxWire('faqxCalcIndiv', { addon: 2, each: false });

  window.addEventListener('hashchange', openFaqFromHash);
  if (window.location.hash === '#faq-checkout-cost' || window.location.hash === '#faq-credits-pro') {
    openFaqFromHash();
  }
})();
</script>

