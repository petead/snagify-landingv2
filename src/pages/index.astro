/* ══ FEATURES SECTION ══ */
/* ── Hero ambient glow derrière la carte ── */
.hero-right::before {
  content: '';
  position: absolute;
  width: 460px; height: 460px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(154,136,253,.14) 0%, transparent 70%);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 1;
  animation: ambientPulse 5s ease-in-out infinite;
}
@keyframes ambientPulse {
  0%,100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  50%      { opacity: .7; transform: translate(-50%, -50%) scale(1.08); }
}


