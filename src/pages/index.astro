}
.faq-q h3 {
  margin: 0;
  flex: 1;
  font: inherit;
  font-weight: inherit;
  letter-spacing: inherit;
  line-height: inherit;
  color: inherit;
  text-align: left;
}
.faq-q:hover { color: var(--purple); }

.faq-icon {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: transparent;
  border: 1px solid var(--ink-25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-60);
