/* ══════════════════════════════════
   SCROLL REVEALS
══════════════════════════════════ */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity .75s cubic-bezier(.16,1,.3,1), transform .75s cubic-bezier(.16,1,.3,1); }
.reveal.in { opacity: 1; transform: translateY(0); }
.reveal-delay-1 { transition-delay: .12s; }
.reveal-delay-2 { transition-delay: .22s; }
.reveal-delay-3 { transition-delay: .34s; }

/* ══ PAIN FINANCIÈRE ══ */
.pain-section {
  padding: 140px 0 160px;
  background: var(--ink);
  position: relative;
  overflow: hidden;
}
/* Top bridge : purple marquee → ink */
.pain-section-bridge {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 60px;
  background: linear-gradient(to bottom, rgba(154,136,253,.06), transparent);
  pointer-events: none;
  z-index: 2;
}

/* Fond dramatique : rouge glow + grain */
.pain-section::before {
  content: '';
  position: absolute; inset: 0;
  z-index: 0;
  background:
    radial-gradient(ellipse 60% 50% at 30% 50%, rgba(255,82,82,.07) 0%, transparent 60%),
    radial-gradient(ellipse 50% 60% at 75% 40%, rgba(154,136,253,.06) 0%, transparent 55%),
    radial-gradient(ellipse 80% 30% at 50% 100%, rgba(255,82,82,.04) 0%, transparent 60%);
  pointer-events: none;
}

/* Ligne décorative horizontale centrale */
.pain-section::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  top: 50%;
  height: 1px;
  z-index: 1;
  background: linear-gradient(90deg, transparent 0%, rgba(255,82,82,.08) 20%, rgba(255,82,82,.15) 50%, rgba(255,82,82,.08) 80%, transparent 100%);
  pointer-events: none;
}

.pain-inner {
  position: relative;
  z-index: 1;
  max-width: 900px;
  margin: 0 auto;
  padding: 0 48px;
  text-align: center;
}

/* Top : chiffre centré seul, il respire */
.pain-top {
  text-align: center;
  padding-bottom: 48px;
  margin-bottom: 48px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.pain-big-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 3.5px;
  color: rgba(255,255,255,.3);
  font-weight: 500;
  margin-bottom: 24px;
}
.pain-big-label::before,
.pain-big-label::after {
  content: '';
  display: block;
  width: 32px;
  height: 1px;
  background: rgba(255,255,255,.15);
}

/* Le chiffre, le vrai star */
.pain-big-num {
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  font-size: clamp(72px, 10vw, 140px);
  letter-spacing: -6px;
  line-height: .9;
  color: var(--white);
  margin-bottom: 20px;
  text-shadow:
    0 0 60px rgba(255,82,82,.25),
    0 0 120px rgba(255,82,82,.12),
    0 0 200px rgba(255,82,82,.06);
  position: relative;
  display: inline-block;
}

/* Soulignement rouge sous le chiffre */
.pain-big-num::after {
  content: '';
  position: absolute;
  bottom: -8px; left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--red), transparent);
  border-radius: 2px;
  opacity: .5;
}

.pain-big-sub {
  font-size: 18px;
  color: rgba(255,255,255,.4);
  line-height: 1.5;
  max-width: 520px;
  margin-left: auto;
  margin-right: auto;
  font-style: italic;
}

.pain-bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.pain-headline {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: clamp(24px, 3vw, 34px);
  line-height: 1.3;
  letter-spacing: -.6px;
  color: var(--white);
  max-width: 720px;
  margin: 0 auto;
}
.pain-headline strong { color: #FF8A65; font-weight: 700; }

@media(max-width: 768px) {
  .pain-section { padding: 100px 0 120px; }
  .pain-inner { padding: 0 20px; }
  .pain-top { padding-bottom: 40px; margin-bottom: 40px; }
}
@media (max-width: 480px) {
  .pain-headline br { display: none; }
}

/* Bouton primaire sur fond dark */
.btn-pros-primary {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 15px 30px;
  background: var(--white);
  color: var(--ink);
  font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 15px;
  border-radius: 999px; text-decoration: none; border: none; cursor: pointer;
  transition: background .3s, transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s;
}
.btn-pros-primary:hover {
  background: var(--purple);
  color: var(--ink);
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(154,136,253,.4);
}
.btn-pros-secondary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 15px 30px;
  background: transparent;
  color: #fff;
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 15px;
  border-radius: 999px;
  text-decoration: none;
  border: 1.5px solid rgba(255,255,255,0.28);
  cursor: pointer;
  transition: border-color .15s, background .15s, transform .12s;
}
.btn-pros-secondary:hover {
  border-color: rgba(255,255,255,0.55);
  background: rgba(255,255,255,0.04);
  transform: translateY(-1px);
}

/* ══ FOR PROS ══ */
.for-pros {
  padding: 0;
  background: var(--ink);
  position: relative;
  overflow: hidden;
}
/* Atmosphère corporate, grille subtile + purple glow */
.for-pros::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 80% 40%, rgba(154,136,253,.09) 0%, transparent 60%),
    radial-gradient(ellipse 40% 40% at 10% 70%, rgba(202,254,135,.04) 0%, transparent 55%);
  pointer-events: none;
}
/* Dot grid subtil en fond */
.for-pros::after {
  content: '';
  position: absolute; inset: 0;
  background-image: radial-gradient(circle, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 80%);
  pointer-events: none;
}

/* Starfield / glitter, subtle twinkle behind content */
.pros-stars {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}
.pros-stars::before,
.pros-stars::after {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 2px; height: 2px;
  border-radius: 50%;
  background: rgba(255,255,255,.9);
  box-shadow:
    8vw 12% 0 0 rgba(255,255,255,.55),
    18vw 28% 0 0 rgba(154,136,253,.7),
    27vw 8% 0 0 rgba(255,255,255,.35),
    36vw 42% 0 0 rgba(202,254,135,.45),
    44vw 18% 0 0 rgba(255,255,255,.6),
    52vw 55% 0 0 rgba(154,136,253,.5),
    61vw 22% 0 0 rgba(255,255,255,.4),
    69vw 48% 0 0 rgba(254,222,128,.4),
    78vw 14% 0 0 rgba(255,255,255,.65),
    86vw 38% 0 0 rgba(154,136,253,.55),
    12vw 62% 0 0 rgba(255,255,255,.3),
    22vw 78% 0 0 rgba(202,254,135,.35),
    33vw 68% 0 0 rgba(255,255,255,.5),
    48vw 82% 0 0 rgba(154,136,253,.4),
    58vw 72% 0 0 rgba(255,255,255,.45),
    74vw 66% 0 0 rgba(255,255,255,.35),
    91vw 58% 0 0 rgba(202,254,135,.4),
    6vw 40% 0 0 rgba(255,255,255,.25),
    95vw 24% 0 0 rgba(255,255,255,.5),
    41vw 6% 0 0 rgba(154,136,253,.45);
  animation: starTwinkle 5.5s ease-in-out infinite;
}
.pros-stars::after {
  width: 1px; height: 1px;
  box-shadow:
    14vw 20% 0 0 rgba(255,255,255,.7),
    24vw 46% 0 0 rgba(154,136,253,.6),
    39vw 32% 0 0 rgba(255,255,255,.4),
    55vw 12% 0 0 rgba(202,254,135,.5),
    67vw 36% 0 0 rgba(255,255,255,.55),
    81vw 52% 0 0 rgba(254,222,128,.45),
    4vw 74% 0 0 rgba(255,255,255,.35),
    29vw 88% 0 0 rgba(154,136,253,.4),
    46vw 64% 0 0 rgba(255,255,255,.5),
    63vw 86% 0 0 rgba(255,255,255,.3),
    72vw 8% 0 0 rgba(202,254,135,.45),
    88vw 76% 0 0 rgba(255,255,255,.55),
    16vw 54% 0 0 rgba(154,136,253,.35),
    50vw 44% 0 0 rgba(255,255,255,.65),
    93vw 42% 0 0 rgba(254,222,128,.35);
  animation: starTwinkle 4.2s ease-in-out infinite 1.4s;
  opacity: .85;
}
@keyframes starTwinkle {
  0%, 100% { opacity: .35; }
  40% { opacity: 1; }
  70% { opacity: .55; }
}

.for-pros-inner {
  position: relative; z-index: 2;
  padding: 120px 0;
}

.for-pros-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* Eyebrow + title + sub en blanc */
.for-pros .section-eyebrow { color: rgba(255,255,255,.4); }
.for-pros .section-eyebrow::before { background: rgba(255,255,255,.3); }
.for-pros .section-title { color: var(--white); }
.for-pros .section-title em { color: var(--purple); }
.for-pros .section-sub { color: rgba(255,255,255,.45); }

/* Features list, one-liners */
.pros-features { display:flex; flex-direction:column; margin:36px 0 40px; }
.pros-feat { display:flex; gap:16px; align-items:center; padding:18px 0; border-bottom:1px solid rgba(255,255,255,.08); }
.pros-feat:first-child { padding-top:0; }
.pros-feat:last-child { border-bottom:none; }
.pros-feat-icon { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.pros-feat-icon svg { width:18px; height:18px; }
.pfi-purple { background:rgba(154,136,253,.12); color:var(--purple); }
.pfi-green { background:rgba(202,254,135,.1); color:var(--green); }
.pfi-jasmine { background:rgba(254,222,128,.1); color:var(--jasmine); }
.pros-feat-line { font-size:15.5px; line-height:1.5; color:rgba(255,255,255,.6); }
.pros-feat-line strong { color:var(--white); font-weight:600; font-family:'Poppins',sans-serif; letter-spacing:-.2px; }

.pros-cta {
  display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
}
/* Override hero-sample-link color for dark bg */
.for-pros .hero-sample-link {
  color: rgba(255,255,255,.4);
  border-color: rgba(255,255,255,.15);
}
.for-pros .hero-sample-link:hover {
  color: var(--purple);
  border-color: var(--purple);
}

/* Branded triptych */
.pros-trip { position:relative; width:100%; max-width:470px; height:720px; margin:0 auto; }
.trip-card { position:absolute; width:360px; background:rgba(22,20,31,.85); border:1px solid rgba(255,255,255,.08); border-radius:20px; backdrop-filter:blur(12px); box-shadow:0 28px 70px rgba(0,0,0,.5); overflow:hidden; will-change:transform; }
.trip-1 { top:0; left:0; transform:rotate(-2.5deg); z-index:1; animation:tripFloat1 7s ease-in-out infinite; }
.trip-2 { top:236px; left:110px; transform:rotate(1.8deg); z-index:2; animation:tripFloat2 8s ease-in-out infinite 1.2s; }
.trip-3 { top:490px; left:10px; transform:rotate(-1.2deg); z-index:3; animation:tripFloat3 6.5s ease-in-out infinite 2.4s; }
@keyframes tripFloat1 {
  0%,100% { transform:rotate(-2.5deg) translateY(0); }
  50% { transform:rotate(-2.5deg) translateY(-8px); }
}
@keyframes tripFloat2 {
  0%,100% { transform:rotate(1.8deg) translateY(0); }
  50% { transform:rotate(1.8deg) translateY(-10px); }
}
@keyframes tripFloat3 {
  0%,100% { transform:rotate(-1.2deg) translateY(0); }
  50% { transform:rotate(-1.2deg) translateY(-7px); }
}
.trip-accent { height:3px; width:100%; }
