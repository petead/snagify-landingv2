---
import fs from 'node:fs';
import CrispChat from '../components/CrispChat.astro';
import Clarity from '../components/Clarity.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import ChatGPTAdsPixel from '../components/ChatGPTAdsPixel.astro';
import HowItWorksFilm from '../components/HowItWorksFilm.astro';
import { fetchPricingCatalog, formatAed } from '../lib/pricing';
import { buildFaqPageLd } from '../lib/faq-ld';
import { homeFaq } from '../lib/faq-content';
import { getPublishedBlogPosts } from '../lib/blog';
import { getPublishedResources, resourceHref } from '../lib/resources';
import Fonts from '../components/Fonts.astro';

const pricing = await fetchPricingCatalog();
const { packs, plans } = pricing;
const faqPageLd = buildFaqPageLd();
const maxProCredits = plans.length ? Math.max(...plans.map((p) => p.creditsPerMonth)) : 50;
const minPackAed = packs.length ? Math.min(...packs.map((p) => p.priceAed)) : 99;
const waBookMessage = 'Hi Snagify, I would like you to do my report for me. My property (size, furnished or not): ';
const waBookHref = 'https://wa.me/971585169329?text=' + encodeURIComponent(waBookMessage);
const bySnagifyPhoto = fs.existsSync('public/images/by-snagify.jpg') ? '/images/by-snagify.jpg' : null;
const diyPhoto = fs.existsSync('public/images/diy.jpg') ? '/images/diy.jpg' : '/screenshots/feat-ai-analysis.png';
const footerBlogPosts = (await getPublishedBlogPosts()).slice(0, 4);
const footerTutorials = (await getPublishedResources('tutorial')).slice(0, 4);

function rollLabel(n: number) {
  return Number.isInteger(n) ? String(n) : String(n);
}

const softwareOffersLd = plans.map((p) => ({
  '@type': 'Offer',
  name: `${p.name} Plan`,
  price: String(Math.round(p.priceMonthlyAnnual)),
  priceCurrency: 'AED',
  priceValidUntil: '2027-12-31',
  availability: 'https://schema.org/InStock',
}));
---
