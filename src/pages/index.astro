.trip-signame { display:flex; justify-content:space-between; font-size:9.5px; color:rgba(255,255,255,.4); border-top:1px solid rgba(255,255,255,.08); padding-top:5px; margin-top:4px; }
.trip-sigtime { color:rgba(255,255,255,.28); }
.trip-sigfoot { display:flex; align-items:center; justify-content:space-between; background:rgba(202,254,135,.06); border:1px solid rgba(202,254,135,.16); border-radius:10px; padding:9px 13px; }
