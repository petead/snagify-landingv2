---
import LegalLayout from '../layouts/LegalLayout.astro';

const title = 'Features: AI Photo Analysis, Ghost Mode, Signed Reports · Snagify';
const description = 'Every Snagify feature in one place: AI photo analysis, ghost mode for check-outs, AI contract reading, signed PDF reports, check-out comparison and smart inventory.';
---
<LegalLayout
  title={title}
  description={description}
  slug="features"
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
>

<section class="features" id="features">
  <div class="section-wrap">
    <div class="section-header reveal">
      <div class="section-eyebrow">Features</div>
      <h1 class="section-title">Everything you need.<br>Nothing you don't.</h1>
    </div>

    <div class="deck-carousel" data-deck-carousel>
    <div class="deck-prez" data-deck-track>

      <!-- ══ 01 AI Photo Analysis ══ -->
      <article class="deck-slide reveal">
        <div class="deck-slide-copy">
          <div class="deck-slide-label">
            <span class="deck-slide-num">1</span>
            <span class="deck-slide-eyebrow">AI Photo Analysis</span>
          </div>
          <h3 class="deck-slide-title">AI catches what<br><em>you'd miss</em>.</h3>
          <div class="deck-subcards">
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span>
              <div><h4>Auto-flags every defect</h4><p>Cracks, damp, stains: spotted the moment you capture.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5l4 4L7 21H3v-4z"/></svg></span>
              <div><h4>Writes the description</h4><p>A clean draft, ready to edit in one tap.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg></span>
              <div><h4>You stay in control</h4><p>Accept, edit or dismiss any finding.</p></div>
            </div>
          </div>
        </div>
        <div class="deck-slide-visual">
          <div class="deck-phones">
            <div class="deck-phone deck-phone--left">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-ai-analysis.png" alt="Photo details with issue flagged and AI-drafted description" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
            <div class="deck-phone deck-phone--right">
              <div class="deck-phone-screen">
                <img src="/screenshots/hero-photo-details.png" alt="Photo details confirming no issues on a clean surface" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- ══ 02 Ghost Mode ══ -->
      <article class="deck-slide deck-slide--reverse reveal reveal-delay-1">
        <div class="deck-slide-copy">
          <div class="deck-slide-label">
            <span class="deck-slide-num">2</span>
            <span class="deck-slide-eyebrow">Ghost Mode · Check-out</span>
          </div>
          <h3 class="deck-slide-title">Re-shoot the exact<br><em>same angle</em>.</h3>
          <div class="deck-subcards">
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></span>
              <div><h4>Check-in photo as a ghost</h4><p>Overlaid on the live camera view.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
              <div><h4>True like-for-like</h4><p>Same room, same angle, months apart.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h6l2-9 4 18 2-9h6"/></svg></span>
              <div><h4>New damage stands out</h4><p>Instantly obvious, side by side.</p></div>
            </div>
          </div>
        </div>
        <div class="deck-slide-visual">
          <div class="deck-phones">
            <div class="deck-phone deck-phone--left">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-ghost-mode.gif" alt="Ghost mode overlaying the check-in photo on the live camera" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
            <div class="deck-phone deck-phone--right">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-ghost-checkout.png" alt="Check-out capture with ghost overlay of the check-in photo" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- ══ 03 AI Contract Reading ══ -->
      <article class="deck-slide reveal">
        <div class="deck-slide-copy">
          <div class="deck-slide-label">
            <span class="deck-slide-num">3</span>
            <span class="deck-slide-eyebrow">AI Contract Reading</span>
          </div>
          <h3 class="deck-slide-title">Upload the contract.<br><em>AI fills in the rest</em>.</h3>
          <div class="deck-subcards">
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
              <div><h4>Reads Ejari &amp; RERA</h4><p>Dubai tenancy contracts, understood natively.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18 3v4h4"/><path d="M8 13h8M8 17h5"/></svg></span>
              <div><h4>Auto-fills the details</h4><p>Tenant, dates, property: no typing.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
              <div><h4>Under 30 seconds</h4><p>From PDF to a ready inspection.</p></div>
            </div>
          </div>
        </div>
        <div class="deck-slide-visual">
          <div class="deck-phones">
            <div class="deck-phone deck-phone--left">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-contract.png" alt="AI analyzing the tenancy contract" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
            <div class="deck-phone deck-phone--right">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-room-selection.png" alt="Room selection auto-filled from the contract" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- ══ 04 The Signed Report ══ -->
      <article class="deck-slide deck-slide--reverse reveal reveal-delay-1">
        <div class="deck-slide-copy">
          <div class="deck-slide-label">
            <span class="deck-slide-num">4</span>
            <span class="deck-slide-eyebrow">The Signed Report</span>
          </div>
          <h3 class="deck-slide-title">Tamper-proof PDF,<br><em>signed by both parties</em>.</h3>
          <div class="deck-subcards">
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
              <div><h4>Landlord + tenant signatures</h4><p>Signed in person or by email link.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
              <div><h4>SHA-256 verified</h4><p>Any edit breaks the document hash.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h2v2h-2zM18 14h3v3h-3zM14 18h2v3h-2zM18 18h3v3h-3z"/></svg></span>
              <div><h4>Scan-to-verify QR</h4><p>Opens the original report online.</p></div>
            </div>
          </div>
        </div>
        <div class="deck-slide-visual">
          <div class="deck-phones">
            <div class="deck-phone deck-phone--left">
              <div class="deck-phone-screen">
                <img src="/screenshots/hiw-03-signature.png" alt="Check-in report awaiting signatures" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
            <div class="deck-phone deck-phone--right">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-signature-legal.png" alt="Signed report page with QR code, both signatures and SHA-256 hash" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- ══ 05 Check-out Comparison ══ -->
      <article class="deck-slide reveal">
        <div class="deck-slide-copy">
          <div class="deck-slide-label">
            <span class="deck-slide-num">5</span>
            <span class="deck-slide-eyebrow">Check-out Comparison</span>
          </div>
          <h3 class="deck-slide-title">Exactly what changed,<br><em>room by room</em>.</h3>
          <div class="deck-subcards">
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3"/><path d="M16 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3"/><path d="M12 3v18"/></svg></span>
              <div><h4>Check-in vs check-out</h4><p>Every room, side by side.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
              <div><h4>Clear verdicts</h4><p>"No change" or "New damage": no grey area.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg></span>
              <div><h4>Nothing slips through</h4><p>Room-level issues tracked to the end.</p></div>
            </div>
          </div>
        </div>
        <div class="deck-slide-visual">
          <div class="deck-phones">
            <div class="deck-phone deck-phone--left">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-checkout-what-changed.png" alt="Check-out report showing what changed room by room" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
            <div class="deck-phone deck-phone--right">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-compare.png" alt="Room comparison with check-in vs check-out photos and verdicts" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- ══ 06 Smart Inventory ══ -->
      <article class="deck-slide deck-slide--reverse reveal reveal-delay-1">
        <div class="deck-slide-copy">
          <div class="deck-slide-label">
            <span class="deck-slide-num">6</span>
            <span class="deck-slide-eyebrow">Smart Inventory</span>
          </div>
          <h3 class="deck-slide-title">Every item tracked,<br><em>every change flagged</em>.</h3>
          <div class="deck-subcards">
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></svg></span>
              <div><h4>Auto-detected inventory</h4><p>AI lists what it sees in each photo.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/><path d="m4.93 4.93 14.14 14.14M19.07 4.93 4.93 19.07"/></svg></span>
              <div><h4>Good → Damaged, caught</h4><p>Condition changes flagged automatically.</p></div>
            </div>
            <div class="deck-subcard">
              <span class="deck-subcard-ico"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
              <div><h4>Deposit-ready evidence</h4><p>Every item, photographed and dated.</p></div>
            </div>
          </div>
        </div>
        <div class="deck-slide-visual">
          <div class="deck-phones">
            <div class="deck-phone deck-phone--left">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-inventory-set-cond.png" alt="Auto-detected inventory: tap any item to set condition" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
            <div class="deck-phone deck-phone--right">
              <div class="deck-phone-screen">
                <img src="/screenshots/feat-inventory-damaged.png" alt="Item condition changed from Good to Damaged: new damage flagged" width="390" height="844" loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </div>
      </article>

    </div>
    <div class="deck-carousel-chrome" aria-hidden="true">
      <p class="deck-swipe-hint" data-deck-hint>
        Swipe
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </p>
      <div class="deck-dots" data-deck-dots></div>
    </div>
    </div>

    <div class="bento bento-pro">
      <!-- ══ BRANDING PRO ══ -->
      <div class="bento-card b-brand reveal">
        <div class="bc-icon bc-ic-jasmine">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z"/></svg>
        </div>
        <div class="bc-eyebrow bc-pro">Branding</div>
        <h3>Full white-label reports</h3>
        <p>Your logo, your agency colours, your RERA number on every report.</p>
        <div class="bc-mock bcm-tint-purple">
          <div class="bcm-rep">
            <div class="bcm-rep-head">
              <div class="bcm-rep-brand">
                <div class="bcm-rep-logo">H</div>
                <div>
                  <div class="bcm-rep-name">Horizon Properties</div>
                  <div class="bcm-rep-sub">Dubai · RERA 12845</div>
                </div>
              </div>
              <span class="bcm-rep-type">Check-in</span>
            </div>
            <div class="bcm-rep-body">
              <div class="bcm-rep-line" style="width:78%"></div>
              <div class="bcm-rep-line" style="width:56%"></div>
            </div>
          </div>
          <div class="bcm-brand-foot">
            <span class="bcm-sw"></span>
            <span class="bcm-hex">Navy · #1B3A5C</span>
          </div>
        </div>
      </div>

      <!-- ══ TEAM PRO ══ -->
      <div class="bento-card b-teamx reveal reveal-delay-1">
        <div class="bc-icon bc-ic-jasmine">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="bc-eyebrow bc-pro">Team</div>
        <h3>One credit pool, whole team</h3>
        <p>Up to 15 agents share credits. Everyone inspects, you stay in control.</p>
        <div class="bc-mock bcm-tint-green">
          <div class="bcm-avatars">
            <span class="bcm-av" style="background:var(--purple)">KA</span>
            <span class="bcm-av" style="background:var(--jasmine);color:var(--ink)">SM</span>
            <span class="bcm-av" style="background:var(--green);color:var(--ink)">RH</span>
            <span class="bcm-av" style="background:var(--ink);color:var(--white)">+4</span>
          </div>
          <div class="bcm-pool">
            <div class="bcm-pool-head">
              <span class="bcm-pool-lbl">Shared credits</span>
              <span class="bcm-pool-n">14 / 20</span>
            </div>
            <div class="bcm-pool-bar"><div class="bcm-pool-fill"></div></div>
          </div>
        </div>
      </div>

      <!-- ══ ALERTS PRO ══ -->
      <div class="bento-card b-alerts reveal reveal-delay-2">
        <div class="bc-icon bc-ic-jasmine">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </div>
        <div class="bc-eyebrow bc-pro">Alerts</div>
        <h3>Never miss a lease renewal</h3>
        <p>Automatic reminders before every lease ends. Book the check-out on time.</p>
        <div class="bc-mock bcm-tint-jasmine">
          <div class="bcm-notif">
            <div class="bcm-notif-ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </div>
            <div>
              <div class="bcm-notif-title">Lease ends in 30 days</div>
              <div class="bcm-notif-sub">Marina Gate T2 · Unit 1204</div>
            </div>
            <span class="bcm-notif-time">now</span>
          </div>
          <div class="bcm-notif bcm-notif-2">
            <div class="bcm-notif-ico bcm-notif-ico-ok">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <div>
              <div class="bcm-notif-title">Check-out booked</div>
              <div class="bcm-notif-sub">JVC · Villa 14B · 28 Mar, 10:00</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="feat-cta">
  <div class="section-wrap">
    <a href="https://app.snagify.net/signup?ref=features" class="feat-cta-btn">Start my free move-in report
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style is:global>
:root {
  --ink-08: rgba(14,14,16,0.05);
  --purple-l: #C4B9FE;
  --red: #FF5252;
}
body { overflow-x: hidden; }

.section-wrap { max-width: 1360px; margin: 0 auto; padding: 0 48px; }
.section-header { margin-bottom: 64px; }
.section-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11px; text-transform: uppercase; letter-spacing: 3.5px;
  color: var(--ink-60); font-weight: 500; margin-bottom: 16px;
}
.section-eyebrow::before { content: ''; width: 20px; height: 1.5px; background: var(--ink-60); }
.section-title {
  font-family: 'Poppins', sans-serif; font-weight: 800;
  font-size: clamp(36px,4vw,58px); line-height: 1.04; letter-spacing: -2px;
  margin-bottom: 16px;
}
.section-title em { font-style: italic; color: var(--purple); }
.section-sub { font-size: 17px; color: var(--ink-60); max-width: 480px; line-height: 1.7; }

/* ══ FEATURES: DECK-STYLE SLIDES ══ */
.features { padding: 80px 0 120px; }

.deck-prez {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 48px;
}
.deck-carousel-chrome { display: none; }
.deck-slide {
  --deck-accent: var(--purple);
  --deck-accent-soft: #C4B9FE;
  position: relative;
  display: flex;
  align-items: center;
  gap: clamp(28px, 5vw, 56px);
  padding: clamp(36px, 5vw, 64px) clamp(28px, 4vw, 56px);
  border-radius: 28px;
  overflow: hidden;
