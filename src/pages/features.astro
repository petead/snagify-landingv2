<script>
// Features deck: mobile swipe affordance (dots + hint + edge fade)
(() => {
  const root = document.querySelector('[data-deck-carousel]');
  const track = document.querySelector('[data-deck-track]');
  const dotsRoot = document.querySelector('[data-deck-dots]');
  const hint = document.querySelector('[data-deck-hint]');
  if (!root || !track || !dotsRoot) return;

  const mq = window.matchMedia('(max-width: 768px)');
  const slides = Array.from(track.querySelectorAll('.deck-slide'));
  if (slides.length < 2) return;

  let dots = [];
  let hintHidden = false;

  function buildDots() {
    dotsRoot.innerHTML = '';
    dots = slides.map((_, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'deck-dot' + (i === 0 ? ' is-active' : '');
      btn.setAttribute('aria-label', `Feature ${i + 1}`);
      btn.addEventListener('click', () => {
        slides[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
      dotsRoot.appendChild(btn);
      return btn;
    });
  }

  function activeIndex() {
    const left = track.scrollLeft;
    let best = 0;
    let bestDist = Infinity;
    slides.forEach((slide, i) => {
      const dist = Math.abs(slide.offsetLeft - left);
      if (dist < bestDist) {
        bestDist = dist;
        best = i;
      }
    });
    return best;
  }

  function sync() {
    if (!mq.matches) return;
    const i = activeIndex();
    dots.forEach((d, idx) => d.classList.toggle('is-active', idx === i));
    root.classList.toggle('is-end', i >= slides.length - 1);
    if (!hintHidden && track.scrollLeft > 12 && hint) {
      hint.hidden = true;
      hintHidden = true;
      track.classList.remove('is-nudge');
    }
  }

  function onFirstInteract() {
    track.classList.remove('is-nudge');
  }

  buildDots();
  sync();

  track.addEventListener('scroll', () => {
    window.requestAnimationFrame(sync);
  }, { passive: true });
  track.addEventListener('pointerdown', onFirstInteract, { once: true });
  track.addEventListener('touchstart', onFirstInteract, { once: true, passive: true });

  if (mq.matches) track.classList.add('is-nudge');
  mq.addEventListener('change', (e) => {
    if (e.matches) {
      if (!hintHidden) track.classList.add('is-nudge');
      sync();
    } else {
      track.classList.remove('is-nudge');
      root.classList.remove('is-end');
    }
  });
})();
</script>

