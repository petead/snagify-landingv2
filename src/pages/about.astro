---
import LegalLayout from '../layouts/LegalLayout.astro';

const faqs = [
  {
    q: 'Is Snagify a snagging company?',
    a: 'No. Snagging is the defect inspection of a brand-new property at developer handover. Snagify is an app for rental condition reports at check-in and check-out, and it does not carry out snagging inspections.',
  },
  {
    q: 'Is a Snagify report approved by the Dubai RDC?',
    a: 'The Rental Dispute Center does not pre-approve any report format, so no tool can claim official approval. It weighs evidence quality: identification, dates, signatures from both parties, photos and integrity. Snagify reports are built on those criteria.',
  },
  {
    q: 'Who is behind Snagify?',
    a: 'Snagify is operated by Seize Montaigne Technologies LLC, a company registered in Sharjah Media City Free Zone (Shams), licence 2647852.01.',
  },
  {
    q: 'Where can I use Snagify?',
    a: 'Snagify is built for Dubai and the UAE rental market. It runs in the browser on any phone, tablet or computer, with no app store download needed.',
  },
];

const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://snagify.net/about#webpage',
  url: 'https://snagify.net/about',
  name: 'About Snagify',
  inLanguage: 'en-AE',
  about: { '@id': 'https://snagify.net/#organization' },
  mainEntity: { '@id': 'https://snagify.net/#software' },
};

const faqPageLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const title = 'About Snagify: The Rental Inspection App for Dubai · Snagify';
const description = 'Snagify is a property inspection app for Dubai rentals: check-in and check-out reports with photos, AI-drafted notes and signatures from both parties.';
---
<LegalLayout
  title={title}
  description={description}
  slug="about"
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  jsonLd={[aboutPageLd, faqPageLd]}
>
<style slot="styles">
:root {
  --green-ink: #3a7a00;
  --jasmine-ink: #7a5a00;
  --purple-l: #C4B9FE;
  --red: #FF5252;
}
body { overflow-x: hidden; }
*, *::before, *::after { box-sizing: border-box; }
h1, h2, h3, p, blockquote, dl, dt, dd, ul { margin: 0; }
a { color: inherit; }
:focus-visible { outline: 2px solid var(--purple); outline-offset: 3px; border-radius: 6px; }
.wrap { max-width: 1360px; margin: 0 auto; padding: 0 48px; }

.eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; text-transform: uppercase; letter-spacing: 3.5px; font-weight: 600; color: var(--ink-60); margin-bottom: 20px; }
.eyebrow:before { content: ""; width: 20px; height: 1.5px; background: currentColor; }
.h2 { font-family: Poppins, sans-serif; font-weight: 800; font-size: clamp(32px, 3.5vw, 48px); line-height: 1.04; letter-spacing: -2px; }
.lead { font-size: 17px; color: var(--ink-60); line-height: 1.75; max-width: 560px; }
.btn-ink { display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px; background: var(--ink); color: var(--white); font-family: Poppins, sans-serif; font-weight: 700; font-size: 14px; border-radius: 999px; text-decoration: none; transition: background .3s, color .3s, transform .3s; }
.btn-ink:hover { background: var(--purple); color: var(--ink); transform: translateY(-3px); }
.btn-ghost { display: inline-flex; align-items: center; font-size: 14px; font-weight: 600; color: var(--ink-60); text-decoration: none; border-bottom: 1px dashed var(--ink-25); padding-bottom: 2px; transition: color .25s, border-color .25s; }
.btn-ghost:hover { color: var(--purple); border-color: var(--purple); }

.hero { padding: 88px 0 110px; }
.hero .wrap { display: grid; grid-template-columns: 1.05fr .95fr; gap: 80px; align-items: center; }
.hero h1 { font-family: Poppins, sans-serif; font-weight: 800; font-size: clamp(44px, 5vw, 72px); line-height: .95; letter-spacing: -3px; margin-bottom: 28px; }
.hero h1 em { font-style: italic; color: var(--purple); }
.definition { font-size: 19px; line-height: 1.7; max-width: 540px; margin-bottom: 36px; }
.definition strong { font-weight: 600; }
.hero-actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }

.record { justify-self: end; width: 100%; max-width: 440px; background: var(--white); border: 1px solid var(--ink-25); border-radius: 28px; box-shadow: 0 32px 80px rgba(14,14,16,.1); overflow: hidden; animation: settle .9s cubic-bezier(.16,1,.3,1) both; }
@keyframes settle { from { opacity: 0; transform: translateY(24px) rotate(1.5deg); } to { opacity: 1; transform: none; } }
.record-head { display: flex; align-items: center; gap: 14px; padding: 26px 30px; border-bottom: 1px solid var(--ink-25); }
.record-mark { width: 46px; height: 46px; border-radius: 13px; background: var(--purple-bg); display: grid; place-items: center; flex-shrink: 0; }
.record-title { font-family: Poppins, sans-serif; font-weight: 800; font-size: 16px; letter-spacing: -.3px; }
.record-sub { font-size: 12px; color: var(--ink-60); }
.record-badge { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; background: var(--green-bg); color: var(--green-ink); font-size: 11px; font-weight: 700; border: 1px solid rgba(202,254,135,.5); white-space: nowrap; }
.record-badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--green-ink); }
.record dl { padding: 8px 30px; }
.record-row { display: grid; grid-template-columns: 120px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px dashed var(--ink-25); font-size: 14px; line-height: 1.5; }
.record-row:last-child { border-bottom: 0; }
.record dt { color: var(--ink-60); font-size: 12.5px; padding-top: 1px; }
.record dd { font-weight: 500; }
.record-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 30px; background: var(--cream); border-top: 1px solid var(--ink-25); }
.record-foot small { font-size: 11px; color: var(--ink-60); line-height: 1.5; }
.qr { width: 52px; height: 52px; flex-shrink: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; padding: 4px; background: var(--white); border: 1px solid var(--ink-25); border-radius: 8px; }
.qr span { background: var(--ink); border-radius: 1px; }
.qr span.o { background: transparent; }

.scope { padding: 100px 0; background: var(--cream-2); border-top: 1px solid var(--ink-25); border-bottom: 1px solid var(--ink-25); }
.scope-head { max-width: 760px; margin-bottom: 56px; }
.scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.scope-col { border-radius: 24px; padding: 36px; border: 1px solid var(--ink-25); }
.scope-col.is { background: var(--white); }
.scope-col.isnot { background: transparent; border-style: dashed; }
.scope-col h3 { font-family: Poppins, sans-serif; font-weight: 700; font-size: 19px; letter-spacing: -.4px; margin-bottom: 22px; display: flex; align-items: center; gap: 12px; }
.tag { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; }
.is .tag { background: var(--green-bg); color: var(--green-ink); }
.isnot .tag { background: #fee2e2; color: var(--red); }
.scope-col ul { list-style: none; display: flex; flex-direction: column; gap: 16px; }
.scope-col li { font-size: 15px; line-height: 1.65; padding-left: 20px; position: relative; }
.scope-col li:before { content: ""; position: absolute; left: 0; top: 10px; width: 8px; height: 8px; border-radius: 2px; }
.is li:before { background: var(--green); }
.isnot li:before { background: transparent; border: 1.5px solid var(--ink-60); }
.scope-col li strong { font-weight: 600; }
.scope-col li span { color: var(--ink-60); }

.story { padding: 110px 0; background: var(--ink); color: var(--white); position: relative; overflow: hidden; }
.story:before { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse 55% 60% at 88% 40%, rgba(154,136,253,.13) 0%, transparent 60%), radial-gradient(ellipse 40% 40% at 8% 80%, rgba(202,254,135,.05) 0%, transparent 55%); pointer-events: none; }
.story .wrap { position: relative; display: grid; grid-template-columns: .9fr 1.1fr; gap: 80px; align-items: start; }
.story .eyebrow { color: rgba(255,255,255,.45); }
.story .h2 { color: var(--white); }
.story-body p { font-size: 17px; line-height: 1.8; color: rgba(255,255,255,.66); }
.story-body p + p { margin-top: 18px; }
.story-body p strong { color: var(--white); font-weight: 600; }
.story-quote { margin: 34px 0; padding: 26px 28px; border-left: 3px solid var(--purple); background: rgba(255,255,255,.04); border-radius: 0 16px 16px 0; font-family: Poppins, sans-serif; font-weight: 700; font-size: 21px; line-height: 1.4; letter-spacing: -.4px; color: var(--white); }
.story-sign { display: flex; align-items: center; gap: 14px; margin-top: 34px; }
.avatar { width: 48px; height: 48px; border-radius: 50%; background: var(--purple); color: var(--ink); display: grid; place-items: center; font-family: Poppins, sans-serif; font-weight: 800; font-size: 16px; }
.story-sign b { display: block; font-family: Poppins, sans-serif; font-size: 15px; }
.story-sign small { color: rgba(255,255,255,.5); font-size: 13px; }
.story-link { color: var(--purple-l); text-decoration: none; border-bottom: 1px dashed rgba(196,185,254,.4); }
.story-link:hover { color: var(--white); }

.flow { padding: 110px 0; }
.flow-head { display: flex; justify-content: space-between; align-items: end; gap: 40px; margin-bottom: 56px; }
.flow-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 2px solid var(--ink); }
.step { padding: 28px 28px 0 0; }
.step + .step { padding-left: 28px; border-left: 1px solid var(--ink-25); }
.step-n { font-family: Poppins, sans-serif; font-weight: 800; font-size: 44px; letter-spacing: -2px; line-height: 1; color: var(--purple); margin-bottom: 18px; }
.step h3 { font-family: Poppins, sans-serif; font-weight: 700; font-size: 17px; letter-spacing: -.3px; margin-bottom: 8px; }
.step p { font-size: 14.5px; line-height: 1.7; color: var(--ink-60); }

.facts { padding: 0 0 110px; }
.facts-box { background: var(--white); border: 1px solid var(--ink-25); border-radius: 28px; padding: 56px; display: grid; grid-template-columns: .8fr 1.2fr; gap: 64px; }
.facts dl { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 40px; }
.facts dt { font-family: Poppins, sans-serif; font-weight: 700; font-size: 15px; margin-bottom: 6px; letter-spacing: -.2px; }
.facts dd { font-size: 14.5px; line-height: 1.7; color: var(--ink-60); }
.facts dd a { color: var(--ink); text-decoration: none; border-bottom: 1px dashed var(--ink-25); }

.faq { padding: 100px 0; background: var(--cream-2); border-top: 1px solid var(--ink-25); }
.faq .wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 80px; }
.faq-list { display: flex; flex-direction: column; gap: 12px; }
.faq details { background: var(--white); border: 1px solid var(--ink-25); border-radius: 18px; padding: 0 26px; transition: box-shadow .3s; }
.faq details[open] { box-shadow: 0 16px 44px rgba(14,14,16,.07); }
.faq summary { list-style: none; cursor: pointer; padding: 22px 0; font-family: Poppins, sans-serif; font-weight: 700; font-size: 16px; letter-spacing: -.2px; display: flex; justify-content: space-between; gap: 20px; align-items: center; }
.faq summary::-webkit-details-marker { display: none; }
.faq summary:after { content: "+"; font-size: 22px; font-weight: 600; color: var(--purple); transition: transform .3s; }
.faq details[open] summary:after { transform: rotate(45deg); }
.faq details p { padding: 0 0 24px; font-size: 15px; line-height: 1.75; color: var(--ink-60); }

.cta { padding: 110px 0; text-align: center; }
.cta .h2 { max-width: 820px; margin: 0 auto 18px; }
.cta .lead { margin: 0 auto 34px; }
.cta-actions { display: flex; justify-content: center; align-items: center; gap: 22px; flex-wrap: wrap; }

@media (max-width: 1024px) {
  .hero .wrap, .story .wrap, .faq .wrap, .facts-box { grid-template-columns: 1fr; gap: 48px; }
  .record { justify-self: start; }
  .flow-grid { grid-template-columns: 1fr 1fr; }
  .step:nth-child(3) { padding-left: 0; border-left: 0; }
  .step { padding-bottom: 28px; }
}
@media (max-width: 720px) {
  .wrap { padding: 0 20px; }
  .hero { padding: 48px 0 72px; }
  .hero h1 { letter-spacing: -2px; }
  .definition { font-size: 17px; }
  .scope, .story, .flow, .faq, .cta { padding: 72px 0; }
  .scope-grid, .facts dl { grid-template-columns: 1fr; }
  .scope-col, .facts-box { padding: 28px; }
  .flow-head { flex-direction: column; align-items: start; }
  .flow-grid { grid-template-columns: 1fr; }
  .step, .step + .step { padding: 24px 0; border-left: 0; border-bottom: 1px solid var(--ink-25); }
  .record-row { grid-template-columns: 1fr; gap: 2px; }
}
@media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
</style>

<main>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">About Snagify</p>
        <h1>The rental inspection app <em>built for Dubai.</em></h1>
        <p class="definition"><strong>Snagify is a property inspection app for Dubai rentals.</strong> Landlords, tenants, agents and property managers use it to record a property's condition at check-in and check-out, with room-by-room photos, AI-drafted notes and signatures from both parties, so a deposit is settled on evidence instead of memory.</p>
        <div class="hero-actions">
          <a class="btn-ink" href="https://app.snagify.net/signup">Start a free check-in</a>
          <a class="btn-ghost" href="/sample-report.pdf">View a sample report</a>
        </div>
      </div>

      <aside class="record" aria-label="Snagify at a glance">
        <div class="record-head">
          <div class="record-mark">
            <svg width="24" height="24" viewBox="0 0 700 700" fill="#9A88FD" aria-hidden="true">
              <path d="M485.977 349.973v118.175L357.375 596.746H232.219L106.332 470.863l-2.813-2.715V349.973h110.457v72.472l80.774 80.672 80.722-80.672V349.973z"/>
              <path d="M596.48 231.852v118.125H485.973v-72.473l-21.191-21.156v-44.047h-31.098v12.957l-28.426-28.383-80.773 80.629v72.473H213.984V231.852l128.641-128.598h125.113l125.879 125.883z"/>
            </svg>
          </div>
          <div>
            <div class="record-title">Snagify at a glance</div>
            <div class="record-sub">Company record</div>
          </div>
          <span class="record-badge"><i></i>Updated Sept 2026</span>
        </div>
        <dl>
          <div class="record-row"><dt>Category</dt><dd>Rental inspection software (check-in, check-out, inventory, key handover)</dd></div>
          <div class="record-row"><dt>Market</dt><dd>Dubai and the UAE rental market</dd></div>
          <div class="record-row"><dt>Used by</dt><dd>Landlords, tenants, real estate agencies, property managers</dd></div>
          <div class="record-row"><dt>Price</dt><dd>Check-ins free. Check-outs from AED 99. Pro plans from AED 299 per month, billed annually</dd></div>
          <div class="record-row"><dt>Languages</dt><dd>Reports in English and Arabic</dd></div>
          <div class="record-row"><dt>Operated by</dt><dd>Seize Montaigne Technologies LLC, Sharjah Media City Free Zone (Shams), licence 2647852.01</dd></div>
        </dl>
        <div class="record-foot">
          <small>Every Snagify report carries a QR code<br>linking back to its original record.</small>
          <div class="qr" aria-hidden="true">
            <span></span><span></span><span></span><span class="o"></span><span></span><span></span><span></span>
            <span></span><span class="o"></span><span></span><span></span><span class="o"></span><span class="o"></span><span></span>
            <span></span><span></span><span></span><span class="o"></span><span></span><span></span><span></span>
            <span class="o"></span><span></span><span class="o"></span><span></span><span class="o"></span><span></span><span class="o"></span>
            <span></span><span class="o"></span><span></span><span class="o"></span><span></span><span></span><span></span>
            <span></span><span></span><span class="o"></span><span></span><span class="o"></span><span class="o"></span><span></span>
            <span></span><span></span><span></span><span class="o"></span><span></span><span class="o"></span><span></span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="scope" aria-labelledby="scope-title">
    <div class="wrap">
      <div class="scope-head">
        <p class="eyebrow">What Snagify is</p>
        <h2 class="h2" id="scope-title">A condition report tool, not a snagging company.</h2>
      </div>
      <div class="scope-grid">
        <div class="scope-col is">
          <h3><span class="tag"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>Snagify is</h3>
          <ul>
            <li><strong>An app for rental inspections.</strong> <span>You or your team walk the property and Snagify turns it into a structured report.</span></li>
            <li><strong>A check-in and check-out workflow.</strong> <span>The check-out is compared photo by photo with the check-in, room by room.</span></li>
            <li><strong>A signed, verifiable record.</strong> <span>Both parties sign, and every report carries a SHA-256 hash and a QR code to its verification page.</span></li>
            <li><strong>Built for Dubai tenancies.</strong> <span>It reads Ejari tenancy contracts and follows the local handover: inventory, keys, meters.</span></li>
          </ul>
        </div>
        <div class="scope-col isnot">
          <h3><span class="tag"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>Snagify is not</h3>
          <ul>
            <li><strong>A snagging service.</strong> <span>It does not inspect new-build properties at developer handover. <a class="btn-ghost" href="/blog/snagging-vs-property-inspection-dubai">Snagging vs inspection</a></span></li>
            <li><strong>Approved by the RDC.</strong> <span>No software is. The Rental Dispute Center weighs evidence quality, and Snagify reports are built on those criteria.</span></li>
            <li><strong>An inspection company.</strong> <span>Snagify does not send inspectors. The inspection is done by the landlord, tenant or agent.</span></li>
            <li><strong>A legal service.</strong> <span>Snagify documents condition. It does not give legal advice or represent anyone at the RDC.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="story" aria-labelledby="story-title">
    <div class="wrap">
      <div>
        <p class="eyebrow">Why it exists</p>
        <h2 class="h2" id="story-title">Built after a deposit dispute at the RDC.</h2>
      </div>
      <div class="story-body">
        <p>Snagify started with a tenancy in Dubai. At move-out, the landlord claimed <strong>AED 4,000 for repainting</strong>. There was no check-in report, only memory and a few phone photos, and the case went to the Rental Dispute Center.</p>
        <p>The dispute was won, but it showed how thin the evidence usually is on both sides. Landlords lose repair costs they cannot prove. Tenants lose deposits for damage they did not cause.</p>
        <blockquote class="story-quote">The first document a judge looks for is the check-in report. Most people do not have one.</blockquote>
        <p>Snagify was built to make that report take 20 minutes on a phone, signed by both parties on the day. <a class="story-link" href="/blog/rdc-deposit-dispute-no-checkin-report">Read the full case</a>.</p>
        <div class="story-sign">
          <div class="avatar" aria-hidden="true">PA</div>
          <div><b>Pierre A</b><small>Founder of Snagify</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="flow" aria-labelledby="flow-title">
    <div class="wrap">
      <div class="flow-head">
        <div>
          <p class="eyebrow">How a report works</p>
          <h2 class="h2" id="flow-title">From move-in to settlement.</h2>
        </div>
        <p class="lead">Two inspections, one comparison. The check-in is free; you only use a credit at check-out.</p>
      </div>
      <div class="flow-grid">
        <div class="step"><div class="step-n">1</div><h3>Check in</h3><p>Walk each room, take photos, and let the AI draft condition notes you confirm or edit.</p></div>
        <div class="step"><div class="step-n">2</div><h3>Sign</h3><p>Landlord and tenant sign on the same phone or by remote link. Refusals are recorded too.</p></div>
        <div class="step"><div class="step-n">3</div><h3>Check out</h3><p>Ghost mode overlays the check-in photo on the camera so every angle matches.</p></div>
        <div class="step"><div class="step-n">4</div><h3>Compare</h3><p>Each room gets a verdict, "No change" or "New damage", in a signed comparison report.</p></div>
      </div>
    </div>
  </section>

  <section class="facts" aria-labelledby="facts-title">
    <div class="wrap">
      <div class="facts-box">
        <div>
          <p class="eyebrow">Key facts</p>
          <h2 class="h2" id="facts-title">The details, stated plainly.</h2>
        </div>
        <dl>
          <div><dt>Electronic signatures</dt><dd>UAE Federal Decree-Law No. 46 of 2021 gives electronic signatures the same effect as handwritten ones.</dd></div>
          <div><dt>Report integrity</dt><dd>A SHA-256 hash is computed on the report. Any edit breaks it, and the QR code opens the original record.</dd></div>
          <div><dt>Pricing</dt><dd>Check-ins are free. Individuals buy credit packs for check-outs, from AED 99. <a href="/#pricing">See pricing</a></dd></div>
          <div><dt>For agencies</dt><dd>White-label reports with your logo and RERA number, and one shared credit pool for the team.</dd></div>
          <div><dt>Languages</dt><dd>Reports in English and Arabic. Support in English, Arabic and French.</dd></div>
          <div><dt>Company</dt><dd>Seize Montaigne Technologies LLC, Sharjah Media City Free Zone (Shams), Sharjah, UAE. <a href="mailto:hello@snagify.net">hello@snagify.net</a></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 class="h2" id="faq-title">About Snagify, answered.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          i === 0 ? (
            <details open>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ) : (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          )
        ))}
      </div>
