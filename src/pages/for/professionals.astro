<script>
// Billing toggle
(() => {
  const t = document.querySelector('.pp-toggle');
  if (!t) return;
  const set = (mode: string) => {
    t.setAttribute('data-billing', mode);
    t.querySelectorAll('button').forEach((b) => {
      const on = b.getAttribute('data-bill') === mode;
      b.classList.toggle('on', on);
      b.setAttribute('aria-selected', String(on));
    });
    document.querySelectorAll<HTMLElement>('.pp-plan [data-annual]').forEach((el) => {
      const v = el.getAttribute(mode === 'annual' ? 'data-annual' : 'data-monthly');
      if (v != null) el.textContent = v;
    });
  };
  t.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => set(b.getAttribute('data-bill') || 'annual')));
})();

// Calculator
(() => {
  const root = document.getElementById('pp-calc');
  if (!root) return;
  type Plan = { name: string; annual: number; credits: number; extra: number };
  let plans: Plan[] = [];
  try { plans = JSON.parse(root.getAttribute('data-plans') || '[]'); } catch { plans = []; }
  if (!plans.length) return;
  const fmt = (x: number) => Math.round(x).toLocaleString('en-US');
  const inN = root.querySelector<HTMLInputElement>('[data-in="n"]');
  const inFee = root.querySelector<HTMLInputElement>('[data-in="fee"]');
  const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`);
  const update = () => {
    const n = Number(inN?.value || 30);
    const fee = Number(inFee?.value || 200);
    let best = { p: plans[0], cost: Infinity };
    plans.forEach((p) => {
      const cost = p.annual + Math.max(0, n - p.credits) * p.extra;
      if (cost < best.cost) best = { p, cost };
    });
    const billed = n * fee;
    const margin = billed - best.cost;
    const set = (k: string, v: string) => { const el = out(k); if (el) el.textContent = v; };
    set('n', String(n));
    set('fee', String(fee));
    set('plan', best.p.name);
    set('per', fmt(best.cost / n));
    set('cost', fmt(best.cost));
    set('billed', fmt(billed));
    set('margin', fmt(Math.abs(margin)));
    set('mlabel', margin >= 0 ? 'Left for the company' : 'Cost absorbed by the company');
    out('box')?.classList.toggle('is-neg', margin < 0);
  };
  inN?.addEventListener('input', update);
  inFee?.addEventListener('input', update);
  update();
})();
</script>

