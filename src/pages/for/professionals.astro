---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { fetchPricingCatalog, formatAed } from '../../lib/pricing';

const { plans } = await fetchPricingCatalog();

const rollLabel = (m: number) =>
  m <= 1 ? 'No rollover' : `Unused credits roll over (up to ${Number.isInteger(m) ? m : m.toFixed(1)}x)`;

const calcPlans = plans.map((p) => ({
  name: p.name,
  annual: p.priceMonthlyAnnual,
  credits: p.creditsPerMonth,
  extra: p.extraCreditAed ?? 0,
}));
const maxCredits = plans.length ? Math.max(...plans.map((p) => p.creditsPerMonth)) : 75;

const waDemo = 'https://wa.me/971585169329?text=' + encodeURIComponent('Hi Snagify, I manage properties and would like a 15-minute demo.');
const calDemo = 'https://cal.com/snagify/15min-demo-snagify';

const brands = [
  { letter: 'H', name: 'Horizon Property Management', color: '#1B3A5C', delay: '0s' },
  { letter: 'P', name: 'Palm & Co. Real Estate', color: '#0F7B6C', delay: '4s' },
  { letter: 'N', name: 'Northbay Homes', color: '#B4532A', delay: '8s' },
];

const rooms = [
  { name: 'Living room', status: 'Good', color: '#3CCB7F' },
  { name: 'Kitchen', status: 'Good', color: '#3CCB7F' },
  { name: 'Bedroom 1', status: 'Damaged', color: '#FF8A65' },
  { name: 'Bathroom', status: 'Fair', color: '#F5C24A' },
];

const pains = [
  { t: 'Every property manager, a different file.', b: "Word here, Excel there, photos on someone's phone. Nothing you can defend." },
  { t: 'A landlord abroad, asking for proof.', b: "They can't visit. All they get is a WhatsApp thread and your word." },
  { t: 'A dispute, and nothing solid.', b: 'No signatures, no dates, no record of what was there on day one.' },
];

const steps = [
  { t: 'Add the unit', b: 'Pick a template, rooms are ready in a minute.' },
  { t: 'Inspect room by room', b: 'Photos, AI flags damage and drafts the notes.' },
  { t: 'Both parties sign', b: "On your inspector's phone, or by link within 7 days." },
  { t: 'Send the branded PDF', b: 'Landlord and tenant get it, wherever they are. Move-out compares automatically.' },
];

const feats = [
  { k: 'brand', t: 'Your brand on every report', b: 'Logo and colours on every page. Snagify stays invisible.' },
  { k: 'team', t: 'One credit pool, whole team', b: 'Your inspectors share credits. You see who did what.' },
  { k: 'ai', t: 'AI photo analysis', b: 'Flags cracks, stains and damage, and drafts the note.' },
  { k: 'ghost', t: 'Ghost mode at move-out', b: 'The move-in photo overlays the camera: same angle, months later.' },
  { k: 'sign', t: 'Remote signatures', b: 'Link valid 7 days, reminders on day 1 and 3, refusals recorded.' },
  { k: 'lock', t: 'Tamper-evident PDF', b: 'A content fingerprint and a QR code on every page.' },
  { k: 'bell', t: 'Lease-end reminders', b: 'Know a move-out is coming before the tenant calls.' },
  { k: 'folder', t: 'Reports stay with the company', b: 'When someone leaves the team, every inspection stays with you.' },
];

const icons: Record<string, string> = {
  brand: '<circle cx="13.5" cy="6.5" r="1"/><circle cx="17.5" cy="10.5" r="1"/><circle cx="8.5" cy="7.5" r="1"/><circle cx="6.5" cy="12.5" r="1"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.93 0 1.65-.75 1.65-1.69 0-.44-.18-.84-.44-1.13-.29-.29-.44-.65-.44-1.13a1.64 1.64 0 0 1 1.67-1.67h2c3.05 0 5.55-2.5 5.55-5.55C21.97 6.01 17.46 2 12 2z"/>',
  team: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  ai: '<path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z"/><path d="M19 17l.7 2.1L22 20l-2.3.9L19 23l-.7-2.1L16 20l2.3-.9z"/>',
  ghost: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  sign: '<path d="M3 17c3 0 4-6 7-6s2 6 5 6 3-3 6-3"/><path d="M3 21h18"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  bell: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
};

const faqs = [
  { q: 'Is a Snagify report accepted by the Rental Disputes Center (RDC)?', a: 'No report format is pre-approved by the RDC, and no app can truthfully claim an official stamp. The RDC weighs the evidence: who the parties are, the dates, both signatures and the photos. Snagify reports are built on exactly that, and electronic signatures are valid under UAE law (Federal Decree-Law No. 46 of 2021).' },
  { q: 'What if the landlord or tenant refuses to sign?', a: 'The refusal is recorded with its date and the reason given. If they never answer the link, the report shows when it was sent, whether it was opened and when the 7-day window closed.' },
  { q: 'Who owns the reports if someone leaves the team?', a: 'The company. Reports belong to your company account, not to the person who made them. Their inspections, units and tenancies stay with you.' },
  { q: 'Can I bill landlords for inspections?', a: 'Yes. Many property management companies and agencies in Dubai charge landlords a move-in and move-out fee. You set your own price, and the branded report is what you deliver for it.' },
  { q: 'Our current tenancies are on paper. Can we switch?', a: 'Yes, from the next move-in. A Snagify move-out compares against a Snagify move-in, so tenancies already running on paper finish on paper. Most teams switch unit by unit as tenancies renew.' },
  { q: 'Can I cancel anytime?', a: 'Yes. Monthly plans cancel in one click. You keep access until the end of the billing period, and every report stays in your account.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const title = 'Inspection Software for Property Managers in Dubai · Snagify';
const description = 'Branded move-in and move-out reports for property management companies and agencies in Dubai. Signed on site, your logo on every page, one plan for the whole team.';
---
<LegalLayout
  title={title}
  description={description}
  slug="for/professionals"
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  jsonLd={[faqLd]}
>

<!-- HERO -->
<section class="pp-hero">
  <div class="pp-dots" aria-hidden="true"></div>
  <div class="pp-wrap pp-hero-in">
    <div class="pp-hero-copy">
      <div class="pp-eb"><span class="pp-eb-dot" aria-hidden="true"></span>For property management companies and agencies</div>
      <h1 class="pp-h1">Every unit.<br>Every inspector.<br><em>Same report.</em></h1>
      <p class="pp-lead">Branded move-in and move-out reports with your logo on every page, signed by landlord and tenant before your team leaves the building. <strong>20 minutes per apartment.</strong></p>
      <div class="pp-ctas">
        <a class="pp-btn pp-btn--ink pp-shine" href="https://app.snagify.net/signup?ref=pro-hero">Start free
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a class="pp-btn pp-btn--line" href={calDemo} target="_blank" rel="noopener noreferrer">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Book a 15-min demo
        </a>
      </div>
      <div class="pp-ticks">
        <span><i aria-hidden="true">✓</i>Works on any phone</span>
        <span><i aria-hidden="true">✓</i>No training needed</span>
        <span><i aria-hidden="true">✓</i>Cancel anytime</span>
      </div>
    </div>
    <div class="pp-hero-visual">
      <div class="pp-report-wrap">
        <div class="pp-report-bg" aria-hidden="true"></div>
        <div class="pp-report" aria-label="Example of a branded move-in report">
          <div class="pp-brands">
            {brands.map((b) => (
              <div class="pp-brand" style={`--d:${b.delay}`}>
                <div class="pp-brand-row">
                  <span class="pp-brand-logo" style={`background:${b.color}`}>{b.letter}</span>
                  <div class="pp-brand-txt"><b>{b.name}</b><span>Property management · Dubai</span></div>
                </div>
                <div class="pp-brand-bar" style={`background:${b.color}`}></div>
              </div>
            ))}
          </div>
          <div class="pp-report-title"><b>Move-in report</b><span>12 Oct 2026</span></div>
          <span class="pp-report-unit">Marina Gate T2 · Unit 1204 · 2BR</span>
          {rooms.map((r) => (
            <div class="pp-room"><span>{r.name}</span><span class="pp-badge" style={`background:${r.color}22`}><i style={`background:${r.color}`}></i>{r.status}</span></div>
          ))}
          <div class="pp-signs">
            <div><b>Landlord</b>Signed 10:42</div>
            <div><b>Tenant</b>Signed 10:44</div>
          </div>
        </div>
        <span class="pp-stamp" aria-hidden="true">Your brand</span>
      </div>
    </div>
  </div>
</section>

<!-- PAINS -->
<section class="pp-sec pp-white">
  <div class="pp-wrap pp-stack">
    <div class="pp-head">
      <div class="pp-eb"><span class="pp-eb-line" aria-hidden="true"></span>Sound familiar?</div>
      <h2 class="pp-h2">Your process is only as strong <em>as your weakest inspector.</em></h2>
    </div>
    <div class="pp-g3">
      {pains.map((p) => (
        <div class="pp-pain">
          <span class="pp-x" aria-hidden="true">✕</span>
          <h3>{p.t}</h3>
          <p>{p.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- HOW -->
<section class="pp-sec pp-cream" id="how">
  <div class="pp-wrap pp-stack">
    <div class="pp-head">
      <div class="pp-eb"><span class="pp-eb-line" aria-hidden="true"></span>How it works</div>
      <h2 class="pp-h2">From keys to signed PDF, <em>in one visit.</em></h2>
    </div>
    <div class="pp-steps">
      {steps.map((s, i) => (
        <div class="pp-step">
          <span class="pp-step-n">{i + 1}</span>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="pp-sec pp-white" id="features">
  <div class="pp-wrap pp-stack">
    <div class="pp-head">
      <div class="pp-eb"><span class="pp-eb-line" aria-hidden="true"></span>Features</div>
      <h2 class="pp-h2">Built for teams, <em>not just one inspector.</em></h2>
    </div>
    <div class="pp-g4">
      {feats.map((f) => (
        <div class="pp-feat">
          <span class="pp-fico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.k]} /></span>
          <h3>{f.t}</h3>
          <p>{f.b}</p>
        </div>
      ))}
    </div>
    <a href="/features" class="pp-link">See every feature
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>

<!-- PLANS -->
<section class="pp-sec pp-cream" id="plans">
  <div class="pp-wrap pp-stack">
    <div class="pp-head">
      <div class="pp-eb"><span class="pp-eb-line" aria-hidden="true"></span>Plans</div>
      <h2 class="pp-h2">One plan for the team. <em>Every report branded.</em></h2>
    </div>
    <div class="pp-toggle" role="tablist" aria-label="Billing period" data-billing="annual">
      <button type="button" role="tab" aria-selected="false" data-bill="monthly">Monthly</button>
      <button type="button" role="tab" aria-selected="true" data-bill="annual" class="on">Annual <span class="pp-save">2 months free</span></button>
    </div>
    <div class="pp-g3 pp-plans">
      {plans.map((p) => (
        <article class={`pp-plan${p.popular ? ' pp-plan--pop' : ''}`}>
          {p.popular && <span class="pp-pop">Most popular</span>}
          <span class="pp-plan-name">{p.name}</span>
          <div class="pp-plan-price">
            <small>AED</small>
            <b data-annual={formatAed(p.priceMonthlyAnnual)} data-monthly={formatAed(p.priceMonthlyBilling)}>{formatAed(p.priceMonthlyAnnual)}</b>
            <small>/ month</small>
          </div>
          <span class="pp-plan-billed" data-annual={`Billed yearly: AED ${formatAed(p.priceAnnualTotal)}`} data-monthly="Billed monthly">Billed yearly: AED {formatAed(p.priceAnnualTotal)}</span>
          <div class="pp-kpis">
            <div class="pp-kpi"><span class="pp-kv">{p.creditsPerMonth}</span><span class="pp-kl">inspections / month</span></div>
            <div class="pp-kpi"><span class="pp-kv">{p.maxUsers != null ? `Up to ${p.maxUsers}` : 'Unlimited'}</span><span class="pp-kl">users</span></div>
          </div>
          <ul class="pp-list">
            <li><i aria-hidden="true">✓</i>Your logo on every report</li>
            <li><i aria-hidden="true">✓</i>Unlimited properties</li>
            <li><i aria-hidden="true">✓</i>{rollLabel(p.rollMaxMultiplier)}</li>
            {p.extraCreditAed != null && <li><i aria-hidden="true">✓</i>Extra inspection: AED {formatAed(p.extraCreditAed)}</li>}
          </ul>
          <a href={`https://app.snagify.net/signup?ref=pro-${p.slug}`} class={`pp-btn ${p.popular ? 'pp-btn--purple' : 'pp-btn--ink'}`}>Start free
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </article>
      ))}
    </div>
    <div class="pp-plans-note">
      <p>1 inspection = 1 credit for an apartment up to 2 bedrooms. 3 bedrooms or villa: 2 credits. Furnished with inventory: +1.</p>
      <p>More than {maxCredits} inspections a month? <a href={waDemo} target="_blank" rel="noopener noreferrer">Talk to us</a></p>
    </div>
  </div>
</section>

<!-- CALCULATOR -->
<section class="pp-sec pp-white">
  <div class="pp-wrap pp-stack">
    <div class="pp-head">
      <div class="pp-eb"><span class="pp-eb-line" aria-hidden="true"></span>Do the maths</div>
      <h2 class="pp-h2">What it costs. <em>What you can bill.</em></h2>
    </div>
    <div class="pp-calc" id="pp-calc" data-plans={JSON.stringify(calcPlans)}>
      <div class="pp-calc-in">
        <label class="pp-range">
          <span><span>Inspections per month</span><b data-out="n">30</b></span>
          <input type="range" min="2" max="120" step="1" value="30" data-in="n" aria-label="Inspections per month">
        </label>
        <label class="pp-range">
          <span><span>Your fee per inspection</span><b>AED <span data-out="fee">200</span></b></span>
          <input type="range" min="0" max="400" step="25" value="200" data-in="fee" aria-label="Your fee per inspection in AED">
        </label>
        <p class="pp-calc-note">Annual billing, apartments up to 2 bedrooms, unfurnished. Many property managers charge landlords a move-in and move-out fee; you set yours.</p>
      </div>
      <div class="pp-calc-out">
        <span class="pp-label">Best plan for you</span>
        <b class="pp-calc-plan" data-out="plan">Growth</b>
        <div class="pp-kpis">
          <div class="pp-kpi"><span class="pp-kv">AED <span data-out="per">26</span></span><span class="pp-kl">cost per inspection</span></div>
          <div class="pp-kpi"><span class="pp-kv">AED <span data-out="cost">769</span></span><span class="pp-kl">per month, all in</span></div>
        </div>
        <div class="pp-margin" data-out="box">
          <span data-out="mlabel">Left for the company</span>
          <b>AED <span data-out="margin">5,231</span></b>
          <small>per month, on AED <span data-out="billed">6,000</span> billed</small>
        </div>
        <a href="https://app.snagify.net/signup?ref=pro-calc" class="pp-btn pp-btn--ink">Start free
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- SAMPLE -->
<section class="pp-sec pp-cream">
  <div class="pp-wrap pp-sample">
    <div class="pp-sample-copy">
      <div class="pp-eb"><span class="pp-eb-line" aria-hidden="true"></span>Sample report</div>
      <h2 class="pp-h2 pp-left">See what your <em>landlords receive.</em></h2>
      <ul class="pp-list pp-list--lg">
        <li><i aria-hidden="true">✓</i>A cover page with your brand</li>
        <li><i aria-hidden="true">✓</i>Every room, with photos and notes</li>
        <li><i aria-hidden="true">✓</i>Both signatures and a verification QR code</li>
      </ul>
      <a href="/sample-report.pdf" target="_blank" rel="noopener" class="pp-btn pp-btn--ink pp-btn--auto">Download a sample report
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div class="pp-sample-visual">
      <div class="pp-sample-bg" aria-hidden="true"></div>
      <img src="/screenshots/feat-pdf.png" alt="A page of a Snagify report with room photos, condition notes and signatures" loading="lazy" decoding="async">
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="pp-sec pp-white" id="faq">
  <div class="pp-wrap pp-stack pp-narrow">
    <div class="pp-head">
      <div class="pp-eb"><span class="pp-eb-line" aria-hidden="true"></span>Questions</div>
      <h2 class="pp-h2">What property managers <em>ask us first.</em></h2>
    </div>
    <div class="pp-faq">
      {faqs.map((f, i) => (
        <details class="pp-fq" open={i === 0}>
          <summary>
            <span class="pp-fqn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.q}</h3>
            <span class="pp-plus" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0E0E10" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="pp-final">
  <div class="pp-final-glow" aria-hidden="true"></div>
  <div class="pp-wrap pp-stack pp-center">
    <h2 class="pp-final-title">Your next handover, <em>on your letterhead.</em></h2>
    <p class="pp-final-sub">Free account. Choose your plan in the app.</p>
    <div class="pp-ctas pp-ctas--center">
      <a class="pp-btn pp-btn--ink pp-shine" href="https://app.snagify.net/signup?ref=pro-final">Start free
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a class="pp-btn pp-btn--white" href={calDemo} target="_blank" rel="noopener noreferrer">Book a 15-min demo</a>
    </div>
  </div>
</section>

<style is:global>
:root { --purple-l: #C4B9FE; }
body { overflow-x: hidden; }
.pp-wrap { max-width: 1180px; margin: 0 auto; padding-left: clamp(20px, 4vw, 48px); padding-right: clamp(20px, 4vw, 48px); box-sizing: border-box; }
.pp-stack { display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
.pp-narrow { max-width: 900px; }
.pp-center { align-items: center; text-align: center; }
.pp-sec { padding: clamp(56px, 6vw, 96px) 0; border-top: 1px solid rgba(14,14,16,0.08); }
.pp-white { background: #FCFCFC; }
.pp-cream { background: #F3F1EB; }
.pp-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; }
.pp-eb { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.24em; font-weight: 500; color: rgba(14,14,16,0.66); }
.pp-eb-line { width: 20px; height: 1.5px; background: rgba(14,14,16,0.66); }
.pp-eb-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--purple); }
.pp-h1 { margin: 0; font-family: 'Poppins', sans-serif; font-weight: 800; font-size: clamp(42px, 5.2vw, 74px); line-height: 1.02; letter-spacing: -0.04em; }
.pp-h1 em, .pp-h2 em { font-style: italic; color: var(--purple); }
.pp-h2 { margin: 0; font-family: 'Poppins', sans-serif; font-weight: 800; font-size: clamp(30px, 3.8vw, 52px); line-height: 1.06; letter-spacing: -0.035em; text-wrap: balance; }
.pp-left { text-align: left; }
.pp-lead { margin: 0; max-width: 540px; font-size: 19px; line-height: 1.55; color: rgba(14,14,16,0.72); }
.pp-lead strong { color: #0E0E10; font-weight: 600; }

.pp-btn { position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 0 28px; border-radius: 999px; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 15.5px; text-decoration: none; transition: transform .25s, background .25s, color .25s; }
.pp-btn:hover { transform: translateY(-3px); }
.pp-btn--ink { background: #0E0E10; color: #FCFCFC; }
.pp-btn--ink:hover { background: var(--purple); color: #0E0E10; }
.pp-btn--purple { background: var(--purple); color: #0E0E10; }
.pp-btn--purple:hover { background: #0E0E10; color: #FCFCFC; }
.pp-btn--line { background: #FCFCFC; color: #0E0E10; border: 1.5px solid rgba(14,14,16,0.18); }
